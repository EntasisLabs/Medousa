{
  "name": "medousa-vscode",
  "displayName": "Medousa",
  "description": "A focused Medousa workshop companion for VS Code",
  "version": "0.1.0",
  "publisher": "EntasisLabs",
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EntasisLabs/Medousa.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Chat"],
  "activationEvents": [
    "onCommand:medousa.ask",
    "onCommand:medousa.configureConnection",
    "onCommand:medousa.newConversation",
    "onCommand:medousa.selectMode",
    "onCommand:medousa.bindUndertaking",
    "onView:medousa.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "medousa",
          "title": "Medousa",
          "icon": "resources/medousa.svg"
        }
      ]
    },
    "views": {
      "medousa": [
        {
          "type": "webview",
          "id": "medousa.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "medousa.ask",
        "title": "Medousa: Ask About This"
      },
      {
        "command": "medousa.configureConnection",
        "title": "Medousa: Configure Connection"
      },
      {
        "command": "medousa.newConversation",
        "title": "Medousa: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "medousa.selectMode",
        "title": "Medousa: Select Agent Mode"
      },
      {
        "command": "medousa.bindUndertaking",
        "title": "Medousa: Bind Forge Undertaking"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "medousa.newConversation",
          "when": "view == medousa.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Medousa",
      "properties": {
        "medousa.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:7419",
          "description": "Medousa workshop daemon URL. Tokens are stored in SecretStorage."
        },
        "medousa.showEngineDetails": {
          "type": "boolean",
          "default": false,
          "description": "Show low-level engine status details in Medousa chat."
        }
      }
    }
  },
  "scripts": {
    "build:dependencies": "tsc -p ../../packages/medousa-client/tsconfig.json && tsc -p ../../packages/medousa-liquid-markdown/tsconfig.json",
    "precheck": "npm run build:dependencies",
    "pretest": "npm run build:dependencies",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=dist/extension.js --sourcemap",
    "bundle:webview": "esbuild src/liquidWebview.ts --bundle --platform=browser --format=iife --outfile=dist/liquidWebview.js --sourcemap",
    "bundle": "npm run bundle:extension && npm run bundle:webview",
    "build": "npm run check && npm run bundle",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@medousa/client": "file:../../packages/medousa-client",
    "@medousa/liquid-markdown": "file:../../packages/medousa-liquid-markdown",
    "@vscode/vsce": "^3.2.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
