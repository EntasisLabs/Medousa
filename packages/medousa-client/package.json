{
  "name": "@medousa/client",
  "version": "0.1.0",
  "description": "Dependency-free TypeScript client for medousa_daemon external surfaces",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src/generated"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:types": "python3 ../../scripts/gen-ts-types.py --output src/generated/daemon_api.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
