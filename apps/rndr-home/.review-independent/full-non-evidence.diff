+        .world_mut()
+        .resource_mut::<Desktop>()
+        .unwrap()
+        .begin(Resource::Activity)
+        .unwrap();
+    send(
+        a.world_mut(),
+        admin_backend::ReadReply {
+            resource: Resource::Activity,
