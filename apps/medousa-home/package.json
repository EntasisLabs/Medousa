    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-svelte": "^2.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.14.0",
    "hyperformula": "^3.3.0",
    "layercake": "^10.0.3",
    "marked": "^18.0.5",
    "mermaid": "^11.16.1",
    "read-excel-file": "^9.3.5",
    "tauri-plugin-mobile-push-api": "^0.1.4"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^2.10.3",
    "@skeletonlabs/tw-plugin": "^0.4.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tauri-apps/cli": "^2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.10.6",
    "material-icon-theme": "^5.37.0",
    "postcss": "^8.5.18",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "jspdf": "^4.2.1",
    "postcss": "^8.5.18"
  }
}
