{
  "name": "medousa-home",
  "version": "0.9.1",
  "description": "Medousa — Life Manageable",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "tsc -p ../../packages/medousa-liquid-markdown/tsconfig.json",
    "build": "vite build",
    "prepare:sidecar": "node scripts/prepare-engine-sidecar-runner.mjs",
    "tauri:build": "npm run prepare:sidecar && node scripts/tauri-build-runner.mjs",
    "build:desktop": "npm run tauri:build",
    "build:full": "node scripts/build-full-package-runner.mjs",
    "build:full:ios": "node scripts/build-full-package-runner.mjs -- --ios",
    "preview": "vite preview",
    "precheck": "node scripts/verify-browser-capabilities.mjs && node scripts/verify-runtime-graph.mjs && tsc -p ../../packages/medousa-liquid-markdown/tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:browser-capabilities": "node scripts/verify-browser-capabilities.mjs",
    "check:runtime-graph": "node scripts/verify-runtime-graph.mjs",
    "test:browser-attacker": "node scripts/browser-attacker-server.mjs",
    "bench:p02": "node --expose-gc scripts/p02-stream-render-baseline.mjs",
    "pretest": "tsc -p ../../packages/medousa-liquid-markdown/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "guide:generate": "node scripts/generate-guide-appendix.mjs && vite-node src/lib/guide/generateLiquidCatalog.ts",
    "guide:generate-liquid": "vite-node src/lib/guide/generateLiquidCatalog.ts",
    "tauri": "tauri",
    "icons:generate": "tauri icon app-icon.json -o src-tauri/icons --ios-color \"#0a0a0b\" && cp src-tauri/icons/128x128.png static/favicon.png",
    "tauri:ios:init": "tauri ios init && npm run ios:prepare",
    "ios:prepare": "bash scripts/ios-prepare.sh",
    "tauri:ios:dev": "npm run ios:prepare && MEDOUSA_LIVE_ACTIVITY=1 tauri ios dev",
    "tauri:ios:dev:sim": "npm run ios:prepare && MEDOUSA_LIVE_ACTIVITY=1 tauri ios dev \"iPhone 16 Pro\"",
    "tauri:ios:build": "npm run ios:prepare && MEDOUSA_LIVE_ACTIVITY=1 tauri ios build",
    "tauri:ios:clean": "bash scripts/ios-clean.sh",
    "tauri:ios:build:testflight": "bash scripts/ios-testflight-build.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.17.0",
    "@medousa/liquid-markdown": "file:../../packages/medousa-liquid-markdown",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@xterm/addon-fit": "^0.11.0",
