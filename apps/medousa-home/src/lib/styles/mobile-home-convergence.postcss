/**
 * Home AVEC convergence widgets — kept out of app.postcss to avoid
 * invalidating the ~14k-line god sheet on every Home tweak.
 * Loaded by MobileShell / HomePanel; not imported from app.postcss.
 */

@layer features {

.mobile-home-brand {
  @apply mt-5;
}

.mobile-home-greeting {
  @apply text-[1.85rem] font-semibold leading-tight tracking-[-0.03em] text-surface-50;
}

.mobile-home-meta {
  @apply mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5;
}

.mobile-home-meta-row {
  @apply inline-flex max-w-full items-center gap-2 text-left transition active:opacity-80;
}

.mobile-home-meta-lead {
  @apply inline-flex h-5 w-5 shrink-0 items-center justify-center;
}

.mobile-home-meta-mark {
  @apply inline-flex h-5 w-5 items-center justify-center rounded-md border border-surface-600/40 bg-surface-900/60 text-content-quiet;
}

.mobile-home-meta-row[style*="--workshop-brand"] .mobile-home-meta-mark {
  color: color-mix(in srgb, var(--workshop-brand) 62%, rgb(var(--color-surface-400)));
  border-color: color-mix(in srgb, var(--workshop-brand) 24%, transparent);
  background: color-mix(in srgb, var(--workshop-brand) 10%, rgb(var(--color-surface-900)));
}

.mobile-home-meta-mark--status {
  transition:
    color 180ms ease,
    border-color 180ms ease,
    background-color 180ms ease;
}

.mobile-home-meta-mark--alive {
  color: rgb(var(--theme-success));
  border-color: color-mix(in srgb, rgb(var(--color-success-400)) 38%, transparent);
  background: color-mix(in srgb, rgb(var(--color-success-400)) 12%, rgb(var(--color-surface-900)));
  animation: mobile-home-status-breathe 3.6s ease-in-out infinite;
}

.mobile-home-meta-mark--warn {
  color: rgb(var(--theme-warning));
  border-color: color-mix(in srgb, rgb(var(--color-warning-400)) 38%, transparent);
  background: color-mix(in srgb, rgb(var(--color-warning-400)) 12%, rgb(var(--color-surface-900)));
  animation: mobile-home-status-breathe 2.8s ease-in-out infinite;
}

.mobile-home-meta-mark--idle {
  color: rgb(var(--theme-text-quiet));
  opacity: 0.9;
}

.mobile-home-meta-label {
  @apply min-w-0 truncate text-[13px] font-medium leading-none;
  color: rgb(var(--theme-text-tertiary));
}

@keyframes mobile-home-status-breathe {
  0%,
  100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.18);
  }
}

.mobile-home-ask-quiet {
  @apply mt-5 flex w-full items-center gap-3 rounded-[22px] border border-surface-500/35 bg-surface-900/70 px-4 py-3.5 text-left transition active:bg-surface-800/80;
}

.mobile-home-ask-quiet-label {
  @apply min-w-0 flex-1 truncate text-[15px];
  color: rgb(var(--theme-text-quiet));
}

.mobile-home-ask-quiet-chevron {
  @apply shrink-0;
  color: rgb(var(--theme-text-quiet));
}

.mobile-home-glance {
  @apply mt-5 grid grid-cols-2 gap-2.5;
}

.mobile-home-glance-tile {
  @apply flex min-h-[8.75rem] flex-col rounded-[20px] border border-surface-500/30 bg-surface-900/55 p-3.5 text-left transition active:bg-surface-800/70;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
}

.mobile-home-glance-tile--daily {
  @apply mt-5 min-h-0 w-full;
}

.mobile-home-glance-kicker {
  @apply text-[10px] font-medium uppercase tracking-[0.12em];
  color: rgb(var(--theme-text-faint));
}

.mobile-home-glance-kicker-accent {
  color: rgb(var(--theme-warning) / 0.85);
}

.mobile-home-glance-hero {
  @apply mt-2 text-[2.35rem] font-semibold tabular-nums leading-none tracking-[-0.04em] text-surface-50;
}

.mobile-home-glance-sub {
  @apply mt-1 text-xs;
  color: rgb(var(--theme-text-quiet));
}

.mobile-home-glance-title {
  @apply mt-2.5 text-[15px] font-semibold leading-snug tracking-tight text-surface-100;
}

.mobile-home-glance-day {
  @apply mt-0.5 text-[1.65rem] font-semibold tabular-nums leading-none tracking-[-0.03em] text-surface-50;
}

.mobile-home-glance-daily-row {
  @apply mt-2.5 flex items-baseline justify-between gap-3;
}

.mobile-home-glance-daily-row .mobile-home-glance-title {
  @apply mt-0;
}

.mobile-home-glance-daily-row .mobile-home-glance-day {
  @apply mt-0;
}

.mobile-home-glance-whisper {
  @apply mt-auto pt-3 line-clamp-1 text-[11px];
  color: rgb(var(--theme-text-quiet));
}

.mobile-home-peer-avatars {
  @apply mt-3 flex items-center gap-1.5;
}

.mobile-home-peer-avatar-chip {
  @apply inline-flex h-7 w-7 items-center justify-center rounded-full border border-surface-600/50 bg-surface-800 text-[9px] font-semibold;
  color: rgb(var(--theme-text-secondary));
}

.mobile-home-continue {
  @apply mt-4 rounded-[20px] border border-surface-500/30 bg-surface-900/55 px-3.5 py-3 text-left;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
}

.mobile-home-continue-kicker {
  @apply mb-2 text-[10px] font-medium uppercase tracking-[0.12em];
  color: rgb(var(--theme-text-faint));
}

.mobile-home-continue-lead {
  @apply flex w-full flex-col gap-1 rounded-xl px-1 py-1.5 text-left transition active:bg-surface-800/60;
}

.mobile-home-continue-lead-top {
  @apply flex items-baseline justify-between gap-3;
}

.mobile-home-continue-lead-title {
  @apply min-w-0 flex-1 text-[16px] font-semibold leading-snug tracking-[-0.015em] text-surface-50;
}

.mobile-home-continue-time {
  @apply shrink-0 text-[11px] tabular-nums;
  color: rgb(var(--theme-text-faint));
}

.mobile-home-continue-preview {
  @apply line-clamp-2 text-[12px] leading-snug;
  color: rgb(var(--theme-text-quiet));
}

.mobile-home-continue-whisper {
  @apply mt-0.5 flex w-full items-baseline justify-between gap-3 border-t border-surface-700/35 px-1 py-2.5 text-left transition active:bg-surface-800/50;
}

.mobile-home-continue-whisper-title {
  @apply min-w-0 flex-1 truncate text-[13px];
  color: rgb(var(--theme-text-tertiary));
}

.mobile-home-rise {
  animation: mobile-home-rise 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--home-rise-delay, 0ms);
}

@keyframes mobile-home-rise {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .mobile-home-rise {
    animation: none;
  }

  .mobile-home-meta-mark--alive,
  .mobile-home-meta-mark--warn {
    animation: none;
  }
}

.mobile-home-menu-btn,
.mobile-chrome-icon {
  @apply inline-flex h-11 w-11 items-center justify-center rounded-full border border-surface-500/40 bg-surface-900/70 text-surface-100 transition active:bg-surface-800;
}

.mobile-chrome-icon:disabled {
  @apply pointer-events-none opacity-35;
}

.mobile-chrome-icon-active {
  @apply border-surface-400/55 bg-surface-800 text-surface-50;
}

.mobile-top-chrome {
  @apply flex shrink-0 items-center justify-between gap-2 px-4 pb-1;
  /* Sole owner of top safe-area — shell no longer pads, so icons sit under the notch once. */
  padding-top: max(0.5rem, env(safe-area-inset-top, 0px));
  background-color: rgb(var(--color-surface-950));
}

.mobile-top-chrome[data-settings-title="true"] {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
}

.mobile-top-chrome[data-settings-title="true"] > :nth-child(2) {
  min-width: 0;
  justify-self: center;
}

.mobile-top-chrome[data-automations-mode="script-editor"] {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 1fr) auto;
}

.mobile-script-title {
  @apply flex min-w-0 items-center justify-center gap-1.5 rounded-full px-2 py-2 text-sm font-medium text-surface-100 transition active:bg-surface-800/70;
}

.mobile-script-dirty {
  @apply h-1.5 w-1.5 shrink-0 rounded-full bg-primary-400;
}

.mobile-script-actions {
  @apply max-w-none shrink-0 gap-1 overflow-visible;
}

.mobile-script-run {
  @apply inline-flex h-10 shrink-0 items-center justify-center gap-1.5 rounded-full bg-surface-100 px-3 text-xs font-semibold transition active:bg-surface-300 disabled:pointer-events-none disabled:opacity-35;
  color: rgb(var(--color-surface-950));
}

/*
 * Chat: one continuous room — title + thread + composer share the shell canvas.
 * Do not restyle message content; only dissolve chrome banding.
 */
.mobile-shell[data-mobile-tab="chat"] .mobile-chat-header {
  background-color: transparent;
  border-bottom-color: transparent;
  padding-left: 1rem;
  padding-right: 1rem;
}

.mobile-shell[data-mobile-tab="chat"] .mobile-bottom-chrome {
  background-color: rgb(var(--color-surface-950) / 0.94);
  border-top-color: rgb(var(--color-surface-500) / 0.18);
}

.mobile-shell[data-mobile-tab="chat"] .mobile-chat-composer {
  border-bottom-color: transparent;
}

.mobile-chrome-actions {
  @apply flex max-w-[min(100%,20rem)] items-center justify-end gap-1.5 overflow-x-auto;
}

.mobile-sessions-menu-item {
  @apply flex w-full items-center gap-3 rounded-xl border-0 bg-transparent text-left text-[15px] font-medium leading-5 text-surface-100 transition active:bg-surface-700/45;
  min-height: 3.25rem;
  padding: 0.5rem 0.625rem;
}

.mobile-sessions-menu-item + .mobile-sessions-menu-item {
  margin-top: 0.125rem;
}

.mobile-sessions-menu-item:hover {
  background: rgb(var(--color-surface-800) / 0.72);
}

.mobile-sessions-menu-icon {
  @apply inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-content-tertiary;
  background: rgb(var(--color-surface-800) / 0.72);
}

.mobile-chrome-leading-spacer {
  @apply h-11 w-11 shrink-0;
}

.mobile-top-chrome[data-automations-mode="flow-editor"] .mobile-chrome-icon {
  @apply h-11 w-11;
}

.mobile-top-chrome[data-automations-mode="script-editor"] .mobile-chrome-icon {
  @apply h-10 w-10;
}

.mobile-chrome-workshop {
  @apply overflow-hidden p-0;
}

.mobile-chrome-workshop[style*="--workshop-brand"] {
  background-color: color-mix(in srgb, var(--workshop-brand) 28%, transparent);
  border-color: color-mix(in srgb, var(--workshop-brand) 45%, transparent);
}

.mobile-chrome-workshop-mono {
  @apply text-[11px] font-semibold tracking-wide text-surface-50;
}

.mobile-dest-menu {
  height: min(88dvh, 52rem);
  max-height: calc(100dvh - max(1rem, env(safe-area-inset-top, 0px)));
}

.mobile-dest-menu-head {
  @apply grid shrink-0 grid-cols-[3.5rem_1fr_3.5rem] items-center px-5 pb-2 pt-1;
}

.mobile-dest-menu-title {
  @apply overflow-hidden text-center text-[15px] font-semibold text-surface-50;
  letter-spacing: -0.01em;
}

.mobile-dest-menu-header-spacer {
  @apply h-11 w-11;
}

.mobile-dest-menu-edit-toggle,
.mobile-dest-menu-done {
  @apply inline-flex min-h-11 items-center border-0 bg-transparent text-[13px] font-semibold disabled:opacity-40;
  color: rgb(var(--theme-link));
}

.mobile-dest-menu-edit-toggle {
  @apply justify-start;
}

.mobile-dest-menu-done {
  @apply justify-end;
}

.mobile-dest-menu-switchers {
  @apply mx-5 mb-2 flex flex-wrap items-center gap-1 rounded-2xl border p-1.5;
  background: rgb(var(--color-surface-800) / 0.72);
  border-color: rgb(var(--color-surface-600) / 0.28);
}

.mobile-dest-menu-switchers .mobile-profile-pill {
  @apply min-h-11 min-w-0 flex-1 gap-2 border-transparent bg-transparent px-2.5 py-2 active:bg-surface-800/70;
}

.mobile-dest-menu-switchers .mobile-profile-monogram {
  @apply h-6 w-6;
}

.mobile-dest-menu-activity {
  @apply inline-flex min-h-11 items-center gap-2 rounded-xl border border-transparent bg-transparent px-2.5 text-xs font-medium leading-none active:bg-surface-800/70;
  color: rgb(var(--theme-text-secondary));
}

.mobile-dest-menu-scroll {
  @apply pt-0;
}

.mobile-dest-menu-edit-intro {
  @apply mt-2 flex flex-col gap-1 rounded-2xl border border-surface-600/35 bg-surface-800/35 px-4 py-3 text-[12px] leading-4 text-content-tertiary;
}

.mobile-dest-menu-edit-intro strong {
  @apply text-[13px] font-semibold text-surface-100;
}

.mobile-dest-menu-section {
  @apply px-1 pb-1 pt-3 text-[11px] font-semibold uppercase leading-[14px] tracking-[0.12em];
  color: rgb(var(--theme-text-quiet));
}

.mobile-dest-menu-list {
  @apply m-0 list-none p-0;
}

.mobile-dest-menu-list--tail {
  @apply mt-3;
}

.mobile-dest-menu-row {
  min-height: 4rem;
  gap: 0.75rem;
  padding: 0.625rem 0.875rem;
}

.mobile-dest-menu-icon {
  @apply inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl p-0 text-content-tertiary;
  background: rgb(var(--color-surface-900) / 0.64);
}

.mobile-dest-menu-edit-row {
  @apply pr-4;
}

.mobile-dest-menu-edit-row-hidden .mobile-dest-menu-icon,
.mobile-dest-menu-edit-row-hidden .mobile-dest-menu-row-title {
  @apply text-content-tertiary;
}

.mobile-dest-menu-edit-state {
  @apply inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-surface-600/50 text-content-tertiary;
}

.mobile-dest-menu-edit-state-active {
  @apply border-surface-400/50 bg-surface-700/50 text-content-link;
}

.mobile-dest-menu-edit-error {
  @apply mx-1 mt-3 rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2 text-[12px] leading-4 text-red-300;
}

.mobile-notes-active-filter {
  @apply mt-1.5 inline-flex min-h-11 max-w-full items-center truncate rounded-full border border-surface-500/40 bg-surface-900/70 px-3 text-[11px] font-medium transition active:bg-surface-800;
  color: rgb(var(--theme-text-secondary));
}

.mobile-notes-filter-sheet {
  width: 100%;
  max-height: min(82dvh, 44rem);
}

.mobile-notes-filter-sheet .mobile-turn-sheet-grabber {
  @apply mt-1.5 h-[3px] w-8;
}

.mobile-notes-filter-sheet .mobile-turn-sheet-header {
  @apply grid-cols-[2.25rem_1fr_2.25rem] px-3 pb-1 pt-0;
}

.mobile-notes-filter-sheet .mobile-turn-sheet-header-spacer {
  @apply h-9 w-9;
}

.mobile-notes-filter-sheet .mobile-turn-sheet-title {
  @apply text-[14px];
}

.mobile-notes-filter-sheet .mobile-sheet-done {
  @apply min-h-9 min-w-9 text-[12px];
}

.mobile-notes-filter-body {
  @apply space-y-3 px-4 pb-4 pt-0.5;
}

.mobile-notes-filter-section-title {
  @apply mb-2 px-0.5 text-[10px] font-semibold uppercase leading-3 tracking-[0.11em];
  color: rgb(var(--theme-text-quiet));
}

.mobile-notes-library-switch {
  @apply flex max-w-full gap-px rounded-lg border p-0.5;
  width: min(12rem, 100%);
  border-color: rgb(var(--color-surface-600) / 0.28);
  background: rgb(var(--color-surface-800) / 0.6);
}

.mobile-notes-library-option {
  @apply min-h-7 min-w-0 flex-1 rounded-md px-2 py-0 text-[12px] font-medium leading-4 transition;
  color: rgb(var(--theme-text-tertiary));
}

.mobile-notes-library-option-active {
  @apply text-surface-50;
  background: rgb(var(--color-surface-700) / 0.7);
  box-shadow: inset 0 0 0 1px rgb(var(--color-surface-500) / 0.24);
}

.mobile-notes-space-options {
  @apply flex flex-wrap gap-x-1 gap-y-0.5;
}

.mobile-notes-space-option {
  @apply inline-flex min-h-8 shrink-0 items-center gap-1 rounded-md border px-2 text-[12px] font-medium leading-4 transition active:bg-surface-700/55;
  border-color: transparent;
  background: transparent;
  color: rgb(var(--theme-text-secondary));
}

.mobile-notes-space-option-active {
  border-color: transparent;
  background: rgb(var(--color-primary-500) / 0.11);
  color: rgb(var(--color-primary-200));
}

.mobile-notes-space-count {
  @apply tabular-nums;
  color: rgb(var(--theme-text-quiet));
}

.mobile-notes-space-check {
  @apply shrink-0;
  color: rgb(var(--color-primary-300));
}

.mobile-notes-view-group {
  @apply rounded-xl;
}

.mobile-notes-view-row {
  min-height: 2.75rem;
  gap: 0.5rem;
  padding: 0.375rem 0.625rem;
}

.mobile-notes-view-row-active {
  background: rgb(var(--color-surface-700) / 0.24);
}

.mobile-notes-view-icon {
  @apply inline-flex h-7 w-7 shrink-0 items-center justify-center text-content-tertiary;
}

.mobile-notes-view-row .mobile-turn-sheet-row-title {
  @apply text-[14px] leading-[18px];
}

.mobile-notes-filter-row {
  @apply flex min-h-11 w-full items-center gap-3 rounded-xl px-2.5 py-2.5 text-left transition active:bg-surface-800/80;
}

.mobile-notes-filter-row-active {
  @apply bg-surface-800/90;
}

/* Tab bar removed — collapse chrome without display:none so ResizeObserver
   / --mobile-bottom-chrome-height stay stable (display:none caused 0↔layout thrash). */
.mobile-bottom-chrome.mobile-bottom-chrome-collapsed {
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  overflow: hidden !important;
  padding: 0 !important;
  border: none !important;
  pointer-events: none;
  visibility: hidden;
}
}
