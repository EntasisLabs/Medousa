/** Shared Files chrome. Uses semantic colors so previews follow the app theme. */
@layer features {
  .files-dock-title {
    min-width: 0;
    flex: 1;
    font-size: 12px;
    font-weight: 600;
    color: rgb(var(--theme-text) / .9);
  }
  .files-browser {
    height: 100%;
  }
  .files-section-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding: .65rem .9rem .35rem;
    flex-shrink: 0;
  }
  .files-section-label {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .065em;
    text-transform: uppercase;
    color: rgb(var(--theme-text-muted));
  }
  .files-count {
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: normal;
    font-weight: 450;
    color: rgb(var(--theme-text-muted) / .75);
  }
  .files-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 27px;
    height: 27px;
    padding: 0 !important;
    border: 1px solid transparent;
    border-radius: 6px;
    color: rgb(var(--theme-text-muted));
    transition: background-color 120ms, color 120ms;
  }
  .files-icon-button:hover, .files-icon-button[aria-expanded="true"], .files-icon-button[aria-pressed="true"] {
    background: rgb(var(--theme-text) / .055);
    color: rgb(var(--theme-text));
  }
  .files-icon-button:disabled {
    opacity: .3;
    cursor: default;
  }
  .files-browser .vault-external-groups {
    padding: .1rem .55rem .8rem;
  }
  .files-browser .vault-external-group {
    padding: .15rem 0 .45rem;
  }
  .files-browser .vault-external-group + .vault-external-group {
    border: 0;
    padding-top: .25rem;
  }
  .files-browser .vault-external-group-header {
    padding-right: .2rem;
    border-radius: 8px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-browser .vault-external-pin-row {
    min-height: 44px;
    gap: .4rem;
    padding: .4rem .35rem !important;
    background: transparent;
  }
  .files-browser .vault-external-pin-row:hover {
    background: rgb(var(--theme-text) / .025);
  }
  .files-root-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 27px;
    height: 27px;
    border-radius: 7px;
    background: rgb(var(--theme-selection) / .085);
    color: rgb(var(--theme-text) / .7);
  }
  .files-root-copy {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }
  .files-root-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 550;
    line-height: 1.35;
    color: rgb(var(--theme-text));
  }
  .files-root-location {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
    line-height: 1.25;
    color: rgb(var(--theme-text-muted));
  }
  .files-browser .vault-external-group-more {
    width: 25px;
    height: 25px;
    opacity: .6;
  }
  .files-browser .vault-external-group-body {
    padding: .25rem 0 0 .7rem;
  }
  .files-tree-list {
    min-width: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .files-folder-shell {
    display: flex;
    align-items: center;
    min-width: 0;
    border-radius: 6px;
  }
  .files-folder-shell:hover {
    background: rgb(var(--theme-text) / .04);
  }
  .files-folder-row {
    display: flex;
    align-items: center;
    flex: 1;
    gap: .45rem;
    min-width: 0;
    min-height: 32px;
    padding: .3rem .35rem !important;
    border-radius: 6px;
    font-size: 12px;
    line-height: 1.35;
    text-align: left;
    color: rgb(var(--theme-text) / .82);
  }
  .files-folder-row > svg {
    flex-shrink: 0;
    color: rgb(var(--theme-text-muted));
  }
  .files-folder-row > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .files-folder-row[aria-expanded="true"] {
    color: rgb(var(--theme-text));
  }
  .files-folder-row[aria-expanded="true"] > svg:last-of-type {
    color: rgb(var(--theme-text) / .7);
  }
  .files-folder-refresh {
    margin-right: 2px;
    opacity: 0;
  }
  .files-folder-shell:hover .files-folder-refresh, .files-folder-shell:focus-within .files-folder-refresh {
    opacity: 1;
  }
  .files-tree-branch {
    min-width: 0;
    margin-left: .7rem;
    padding-left: .5rem;
    border-left: 1px solid rgb(var(--theme-border) / .2);
  }
  .files-row--compact {
    position: relative;
    border-radius: 6px;
    margin: 1px 0;
  }
  .files-row--compact .vault-external-file-row {
    min-height: 32px;
    gap: .5rem;
    padding: .3rem .4rem .3rem 1.25rem !important;
  }
  .files-row--compact .vault-external-file-icon {
    width: 16px;
    height: 18px;
    border-radius: 0;
    background: transparent;
  }
  .files-row--compact .vault-external-file-name {
    font-size: 12px;
    line-height: 1.35;
    font-weight: 400;
  }
  .files-row--compact .vault-external-file-copy {
    gap: 0;
  }
  .files-row--compact.vault-external-file-shell-selected {
    background: rgb(var(--theme-selection) / .14);
    box-shadow: none;
  }
  .files-row--compact.vault-external-file-shell-selected::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: rgb(var(--theme-focus) / .8);
  }
  .files-row-size {
    flex-shrink: 0;
    margin-left: auto;
    padding-left: .35rem;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--theme-text-muted) / .85);
  }
  .files-row--compact .vault-external-file-link {
    width: 23px;
    height: 25px;
  }
  .files-tree-feedback {
    display: flex;
    align-items: flex-start;
    gap: .45rem;
    margin: .25rem .3rem .4rem .9rem;
    padding: .45rem .5rem;
    font-size: 11px;
    line-height: 1.5;
    color: rgb(var(--theme-text-muted));
  }
  .files-tree-feedback > svg {
    margin-top: 2px;
    flex-shrink: 0;
  }
  .files-tree-feedback p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .files-tree-feedback--error {
    border: 1px solid rgb(var(--theme-border) / .35);
    border-radius: 7px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-tree-hint {
    font-size: 10px;
    opacity: .75;
  }
  .files-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .25rem;
    margin: .5rem .3rem .25rem .8rem;
    padding-top: .4rem;
    border-top: 1px solid rgb(var(--theme-border) / .25);
    color: rgb(var(--theme-text-muted));
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .files-pager .files-button {
    font-size: 10px;
    min-height: 25px;
    padding: .2rem .4rem !important;
  }
  .files-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    min-height: 28px;
    flex-shrink: 0;
    padding: .3rem .65rem !important;
    border: 1px solid rgb(var(--theme-border) / .42);
    border-radius: 6px;
    color: rgb(var(--theme-text) / .85);
    background: rgb(var(--theme-text) / .025);
    font-size: 11px;
    line-height: 1.3;
    font-weight: 450;
    transition: background-color 120ms, border-color 120ms;
  }
  .files-button:hover:not(:disabled) {
    background: rgb(var(--theme-text) / .065);
    border-color: rgb(var(--theme-border) / .65);
    color: rgb(var(--theme-text));
  }
  .files-button:disabled {
    opacity: .35;
    cursor: default;
  }
  .files-button--quiet {
    background: transparent;
    border-color: transparent;
    color: rgb(var(--theme-text-muted));
  }
  .files-button--primary {
    background: rgb(var(--theme-selection) / .16);
    border-color: rgb(var(--theme-focus) / .35);
    color: rgb(var(--theme-text));
  }
  .files-empty {
    display: flex;
    flex: 1;
    min-height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .files-empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: .3rem;
    border: 1px solid rgb(var(--theme-border) / .35);
    border-radius: 13px;
    color: rgb(var(--theme-text-muted));
    background: rgb(var(--theme-text) / .025);
  }
  .files-empty h3 {
    margin: 0;
    color: rgb(var(--theme-text));
    font-size: 13px;
    font-weight: 550;
  }
  .files-empty p {
    max-width: 24rem;
    margin: 0;
    font-size: 11px;
    line-height: 1.65;
    color: rgb(var(--theme-text-muted));
  }
  .files-search-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding: .75rem .4rem;
    color: rgb(var(--theme-text-muted));
    font-size: 10px;
  }
  .files-search-summary strong {
    font-weight: 500;
    color: rgb(var(--theme-text) / .75);
  }
  .files-preview-header {
    display: flex;
    align-items: center;
    gap: .7rem;
    flex-shrink: 0;
    min-height: 68px;
    padding: .7rem 1.1rem;
    border-bottom: 1px solid rgb(var(--theme-border) / .3);
  }
  .files-preview-file-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid rgb(var(--theme-border) / .22);
    border-radius: 9px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-preview-heading {
    min-width: 0;
    flex: 1;
  }
  .files-preview-title-line {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: .5rem;
  }
  .files-preview-title-line h2 {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--theme-text));
    font-size: 13px;
    line-height: 1.4;
    font-weight: 550;
  }
  .files-format-badge {
    flex-shrink: 0;
    max-width: 6rem;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 1px 5px;
    border: 1px solid rgb(var(--theme-border) / .3);
    border-radius: 4px;
    color: rgb(var(--theme-text-muted));
    font-size: 9px;
    font-weight: 500;
    line-height: 1.5;
  }
  .files-location {
    display: flex;
    align-items: center;
    gap: .2rem;
    min-width: 0;
    margin-top: .2rem;
    overflow: hidden;
    font-size: 10px;
    line-height: 1.4;
    color: rgb(var(--theme-text-muted));
  }
  .files-location > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .files-location > svg {
    flex-shrink: 0;
    opacity: .6;
  }
  .files-document-toolbar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem;
    min-height: 42px;
    padding: .4rem 1.05rem;
    border-bottom: 1px solid rgb(var(--theme-border) / .24);
  }
  .files-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem;
  }
  .files-save-state {
    display: flex;
    align-items: center;
    gap: .35rem;
    font-size: 10px;
    color: rgb(var(--theme-text-muted));
  }
  .files-draft-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--theme-focus));
  }
  .files-segments {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    gap: 1px;
    border: 1px solid rgb(var(--theme-border) / .3);
    border-radius: 7px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-segments button {
    min-height: 24px;
    padding: .2rem .55rem !important;
    border: 1px solid transparent;
    border-radius: 5px;
    font-size: 10px;
    line-height: 1.2;
    color: rgb(var(--theme-text-muted));
  }
  .files-segments button:hover {
    color: rgb(var(--theme-text));
  }
  .files-segments button[aria-pressed="true"] {
    border-color: rgb(var(--theme-border) / .3);
    background: rgb(var(--theme-pane));
    color: rgb(var(--theme-text));
    box-shadow: 0 1px 2px rgb(0 0 0 / .12);
  }
  .files-pdf-navigation {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    border: 1px solid rgb(var(--theme-border) / .32);
    border-radius: 7px;
    padding: 1px;
    color: rgb(var(--theme-text) / .8);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .files-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgb(var(--theme-border) / .4);
    border-radius: 6px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-select {
    appearance: none;
    min-height: 28px;
    padding: .3rem 1.8rem .3rem .65rem !important;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: rgb(var(--theme-text) / .85);
    font-size: 10px;
    line-height: 1.3;
    cursor: pointer;
  }
  .files-select-wrap > svg {
    position: absolute;
    right: .5rem;
    pointer-events: none;
    color: rgb(var(--theme-text-muted));
  }
  .files-pdf-stage {
    min-height: 0;
    flex: 1;
    overflow: auto;
    padding: 24px;
    background: rgb(var(--theme-text) / .025);
  }
  .files-pdf-stage canvas {
    display: block;
    margin-inline: auto;
    background: white;
    border-radius: 2px;
    box-shadow: 0 3px 7px rgb(0 0 0 / .12), 0 18px 50px rgb(0 0 0 / .2);
  }
  .files-image-stage {
    display: flex;
    min-height: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
    overflow: auto;
    padding: 24px;
    background: rgb(var(--theme-text) / .018);
  }
  .files-image-stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 5px;
    border: 1px solid rgb(var(--theme-border) / .25);
    box-shadow: 0 8px 35px rgb(0 0 0 / .15);
    background: repeating-conic-gradient(rgb(var(--theme-border) / .12) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px;
  }
  .files-preview-alert {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    padding: .65rem 1rem;
    border-bottom: 1px solid rgb(var(--theme-border) / .4);
    background: rgb(var(--theme-text) / .025);
    color: rgb(var(--theme-text-muted));
    font-size: 11px;
    line-height: 1.6;
  }
  .files-search-results .vault-external-file-meta {
    font-size: 10px;
    line-height: 1.4;
  }
  .files-sheet-body {
    padding: 1rem 1.1rem;
  }
  .files-sheet table {
    color: rgb(var(--theme-text) / .85);
    font-size: 12px;
  }
  .files-sheet th {
    padding: .6rem .75rem;
    border-bottom: 1px solid rgb(var(--theme-border) / .5);
    background: rgb(var(--theme-pane));
    color: rgb(var(--theme-text-muted));
    font-size: 10px;
    font-weight: 550;
  }
  .files-sheet td {
    padding: .5rem .75rem;
    border-bottom: 1px solid rgb(var(--theme-border) / .22);
  }
  .files-sheet tbody tr:hover {
    background: rgb(var(--theme-text) / .025);
  }
  @media (max-width: 560px) {
    .files-open-external span {
      display: none;
    }
    .files-open-external {
      width: 28px;
      padding-inline: 0 !important;
    }
    .files-preview-header {
      gap: .5rem;
      padding-inline: .75rem;
    }
    .files-document-toolbar {
      padding-inline: .75rem;
    }
    .files-pdf-stage, .files-image-stage {
      padding: 16px;
    }
  }
  @media (pointer: coarse) {
    .files-icon-button {
      min-width: 36px;
      min-height: 36px;
    }
    .files-folder-row, .files-row--compact .vault-external-file-row {
      min-height: 40px;
    }
    .files-folder-refresh {
      opacity: .65;
    }
    .files-button {
      min-height: 36px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .files-button, .files-icon-button {
      transition: none;
    }
  }
}

