/**
 * Spotlight is a theme-native telescope into the live workshop.
 * Loaded by the destination feature entry; not imported from app.postcss.
 */

@layer features {
  .command-spotlight-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 1rem;
    padding-top: clamp(3.5rem, 9vh, 7rem);
    background: color-mix(in srgb, rgb(var(--theme-canvas)) 68%, transparent);
    backdrop-filter: blur(5px) saturate(0.88);
  }

  .command-spotlight-panel {
    width: min(100%, 38rem);
    max-height: min(42rem, calc(100vh - 7rem));
    overflow: hidden;
    border: 1px solid rgb(var(--theme-border) / 0.42);
    border-radius: var(--theme-container-radius, 0.875rem);
    background: rgb(var(--theme-pane) / var(--theme-chrome-alpha, 0.96));
    color: rgb(var(--theme-text));
    box-shadow:
      0 28px 70px rgb(var(--theme-shadow) / 0.34),
      0 0 0 1px rgb(var(--theme-focus) / 0.05);
  }

  .command-spotlight-panel-wide {
    width: min(100%, 58rem);
  }

  .command-spotlight-input {
    display: block;
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(var(--theme-border) / 0.28);
    background: transparent;
    padding: 1rem 1.15rem 0.9rem;
    color: rgb(var(--theme-text));
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.005em;
    outline: none;
    caret-color: rgb(var(--theme-focus));
  }

  .command-spotlight-input::placeholder {
    color: rgb(var(--theme-placeholder));
    opacity: 1;
  }

  .command-spotlight-mode-chip {
    margin: -0.18rem 1.15rem 0.45rem;
    color: rgb(var(--theme-focus));
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .command-spotlight-prompt-header {
    border-bottom: 1px solid rgb(var(--theme-border) / 0.28);
    padding: 0.8rem 1.15rem;
  }

  .command-spotlight-kicker {
    margin: 0;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .command-spotlight-prompt-label {
    margin: 0.2rem 0 0;
    color: rgb(var(--theme-text));
    font-size: 0.8125rem;
  }

  .command-spotlight-scopes {
    display: flex;
    min-width: 0;
    height: 2.75rem;
    align-items: stretch;
    gap: 0.35rem;
    overflow-x: auto;
    border-bottom: 1px solid rgb(var(--theme-border) / 0.3);
    padding: 0 0.75rem;
    scrollbar-width: none;
  }

  .command-spotlight-scopes::-webkit-scrollbar {
    display: none;
  }

  .command-spotlight-scope {
    position: relative;
    display: inline-flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    overflow: hidden;
    border: 0;
    background: transparent;
    padding: 0 0.8rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 120ms ease, background-color 120ms ease;
  }

  .command-spotlight-scope::after {
    position: absolute;
    right: 0.55rem;
    bottom: 0;
    left: 0.55rem;
    height: 1px;
    background: transparent;
    content: "";
  }

  .command-spotlight-scope:hover {
    background: rgb(var(--theme-card-hover) / 0.42);
    color: rgb(var(--theme-text-secondary));
  }

  .command-spotlight-scope-active {
    color: rgb(var(--theme-text));
  }

  .command-spotlight-scope-active::after {
    background: rgb(var(--theme-focus));
  }

  .command-spotlight-body {
    display: flex;
    min-height: 19rem;
    max-height: min(30rem, calc(100vh - 14rem));
  }

  .command-spotlight-results {
    min-width: 0;
    flex: 1 1 51%;
    overflow-y: auto;
    padding: 0.45rem;
    scrollbar-color: rgb(var(--theme-border) / 0.5) transparent;
    scrollbar-width: thin;
  }

  .command-spotlight-results::-webkit-scrollbar,
  .command-spotlight-preview-body::-webkit-scrollbar,
  .command-spotlight-preview-markdown::-webkit-scrollbar {
    width: 0.35rem;
  }

  .command-spotlight-results::-webkit-scrollbar-thumb,
  .command-spotlight-preview-body::-webkit-scrollbar-thumb,
  .command-spotlight-preview-markdown::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgb(var(--theme-border) / 0.5);
  }

  .command-spotlight-section-label {
    padding: 0.78rem 0.8rem 0.36rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.115em;
    text-transform: uppercase;
  }

  .command-spotlight-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .command-spotlight-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.65rem;
    border: 0;
    border-radius: var(--menu-row-radius, 0.45rem);
    background: transparent;
    padding: 0.48rem 0.72rem;
    color: rgb(var(--theme-text-secondary));
    text-align: left;
    transition: background-color 100ms ease, color 100ms ease;
  }

  .command-spotlight-row:hover:not(:disabled) {
    background: rgb(var(--theme-card-hover) / 0.5);
    color: rgb(var(--theme-text));
  }

  .command-spotlight-row-active {
    background: rgb(var(--theme-selection) / 0.12);
    color: rgb(var(--theme-text));
    box-shadow: inset 2px 0 0 rgb(var(--theme-focus) / 0.82);
  }

  .command-spotlight-row-icon {
    display: inline-flex;
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: rgb(var(--theme-text-tertiary));
  }

  .command-spotlight-row-active .command-spotlight-row-icon {
    color: rgb(var(--theme-focus));
  }

  .command-spotlight-row-copy {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.16rem;
  }

  .command-spotlight-row-title,
  .command-spotlight-row-subtitle {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command-spotlight-row-title {
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.32;
  }

  .command-spotlight-row-subtitle {
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .command-spotlight-row-meta {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
  }

  .command-spotlight-attention {
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    color: rgb(var(--theme-warning));
    font-size: 0.625rem;
  }

  .command-spotlight-hint {
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.6875rem;
  }

  .command-spotlight-empty {
    padding: 2.5rem 1rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.75rem;
    text-align: center;
  }

  .command-spotlight-preview {
    display: flex;
    min-width: 0;
    flex: 1 1 49%;
    flex-direction: column;
    overflow: hidden;
    border-left: 1px solid rgb(var(--theme-border) / 0.32);
    background: rgb(var(--theme-card) / 0.34);
    padding: 0.85rem;
  }

  .command-spotlight-preview-title {
    overflow: hidden;
    margin: 0 0 0.65rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command-spotlight-preview-body {
    max-height: 100%;
    overflow: auto;
    margin: 0;
    color: rgb(var(--theme-text-secondary));
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1.55;
    scrollbar-color: rgb(var(--theme-border) / 0.5) transparent;
    scrollbar-width: thin;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .command-spotlight-workspace-preview {
    min-height: 0;
    height: 100%;
  }

  .command-spotlight-preview-markdown {
    min-height: 0;
    overflow: auto;
    color: rgb(var(--theme-text-secondary));
    font-size: 0.76rem;
    line-height: 1.55;
    scrollbar-color: rgb(var(--theme-border) / 0.5) transparent;
    scrollbar-width: thin;
  }

  .command-spotlight-preview-markdown :where(h1, h2, h3) {
    margin-top: 0.6em;
    color: rgb(var(--theme-text));
  }

  .command-spotlight-preview-tabs {
    display: flex;
    flex: 0 0 auto;
    gap: 0.1rem;
    overflow-x: auto;
    margin: -0.2rem -0.2rem 0.75rem;
    border-bottom: 1px solid rgb(var(--theme-border) / 0.3);
    scrollbar-width: none;
  }

  .command-spotlight-preview-tab {
    overflow: hidden;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    padding: 0.45rem 0.55rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command-spotlight-preview-tab-active {
    border-bottom-color: rgb(var(--theme-focus));
    color: rgb(var(--theme-text));
  }

  .command-spotlight-chat-preview {
    min-height: 0;
    overflow: auto;
    border: 1px solid rgb(var(--theme-border) / 0.28);
    border-radius: calc(var(--theme-control-radius) * 0.8);
    background: rgb(var(--theme-pane) / 0.5);
    padding: 0.9rem;
  }

  .command-spotlight-chat-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: rgb(var(--theme-focus));
    font-size: 0.6875rem;
  }

  .command-spotlight-chat-preview p {
    margin: 0.75rem 0 0;
    color: rgb(var(--theme-text-secondary));
    font-size: 0.76rem;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .command-spotlight-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgb(var(--theme-border) / 0.3);
    padding: 0.65rem 0.95rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.65rem;
  }

  .command-spotlight-kbd {
    border: 1px solid rgb(var(--theme-border) / 0.42);
    border-radius: 0.25rem;
    padding: 0.1rem 0.34rem;
    color: rgb(var(--theme-text-tertiary));
  }

  @media (max-width: 720px) {
    .command-spotlight-backdrop {
      align-items: stretch;
      padding: 0.65rem;
    }

    .command-spotlight-panel,
    .command-spotlight-panel-wide {
      max-height: calc(100vh - 1.3rem);
    }

    .command-spotlight-preview {
      display: none;
    }

    .command-spotlight-body {
      max-height: none;
      flex: 1;
    }

    .command-spotlight-footer span:first-child {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
}
