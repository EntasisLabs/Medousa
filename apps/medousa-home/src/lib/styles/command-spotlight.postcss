/**
 * Command spotlight overlay.
 * Loaded by the destination feature entry; not imported from app.postcss.
 */

@layer features {


  .command-spotlight-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 1rem;
    padding-top: 12vh;
    background: rgb(var(--color-surface-950) / 0.72);
    backdrop-filter: blur(3px) saturate(1.05);
  }

  html:not(.dark) .command-spotlight-backdrop {
    background: rgb(var(--color-surface-50) / 0.72);
  }

  .command-spotlight-panel {
    width: min(100%, 36rem);
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--color-surface-700) / 0.6);
    background: rgb(var(--color-surface-900));
    color: rgb(var(--color-surface-50));
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.45);
  }

  html:not(.dark) .command-spotlight-panel {
    background: rgb(var(--color-surface-50));
    color: rgb(var(--color-surface-900));
    border-color: rgb(var(--color-surface-300) / 0.85);
  }

  .command-spotlight-panel-wide {
    width: min(100%, 48rem);
  }

  .command-spotlight-mode-chip {
    margin: 0;
    padding: 0.2rem 1rem 0.45rem;
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--theme-text-tertiary));
  }

  .command-spotlight-body {
    display: flex;
    min-height: 0;
    max-height: 22rem;
  }

  .command-spotlight-preview {
    flex: 0 0 14rem;
    overflow: hidden;
    border-left: 1px solid rgb(var(--color-surface-700) / 0.55);
    padding: 0.55rem 0.65rem 0.75rem;
    background: color-mix(in srgb, var(--color-surface-950) 55%, transparent);
  }

  html:not(.dark) .command-spotlight-preview {
    border-left-color: rgb(var(--color-surface-300) / 0.7);
    background: rgb(var(--color-surface-100) / 0.65);
  }

  .command-spotlight-preview-title {
    margin: 0 0 0.35rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgb(var(--theme-text-tertiary));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command-spotlight-preview-body {
    margin: 0;
    max-height: 18rem;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1.45;
    color: rgb(var(--theme-text-secondary));
  }

  html:not(.dark) .command-spotlight-preview-body {
    color: rgb(var(--color-surface-700));
  }

  .command-spotlight-input {
    display: block;
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(var(--color-surface-800) / 0.9);
    background: transparent;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: inherit;
    outline: none;
  }

  .command-spotlight-input::placeholder {
    color: rgb(var(--theme-placeholder));
  }

  .command-spotlight-prompt-header {
    border-bottom: 1px solid rgb(var(--color-surface-800) / 0.9);
    padding: 0.75rem 1rem;
  }

  .command-spotlight-kicker {
    font-size: 0.75rem;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-prompt-label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .command-spotlight-results {
    flex: 1 1 auto;
    min-width: 0;
    max-height: 22rem;
    overflow-y: auto;
    padding-block: 0.25rem;
  }

  .command-spotlight-section-label {
    padding: 0.5rem 0.75rem 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .command-spotlight-row {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    text-align: left;
    font-size: 0.875rem;
    color: rgb(var(--theme-text));
    background: transparent;
    transition: background-color 120ms ease;
  }

  html:not(.dark) .command-spotlight-row {
    color: rgb(var(--theme-text));
  }

  .command-spotlight-row:hover:not(:disabled) {
    background: rgb(var(--color-surface-800) / 0.8);
  }

  html:not(.dark) .command-spotlight-row:hover:not(:disabled) {
    background: rgb(var(--color-surface-200) / 0.85);
  }

  .command-spotlight-row-active {
    background: rgb(var(--color-primary-500) / 0.15);
    color: rgb(var(--theme-text));
  }

  html:not(.dark) .command-spotlight-row-active {
    color: rgb(var(--theme-text));
  }

  .command-spotlight-row-copy {
    min-width: 0;
    flex: 1 1 auto;
  }

  .command-spotlight-row-title,
  .command-spotlight-row-subtitle {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .command-spotlight-row-subtitle {
    font-size: 0.75rem;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-row-meta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .command-spotlight-attention {
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.625rem;
    color: rgb(var(--theme-warning) / 0.9);
  }

  .command-spotlight-hint {
    font-size: 0.75rem;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-empty {
    padding: 2rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgb(var(--color-surface-800) / 0.9);
    padding: 0.5rem 1rem;
    font-size: 0.6875rem;
    color: rgb(var(--theme-text-quiet));
  }

  .command-spotlight-kbd {
    border-radius: 0.25rem;
    border: 1px solid rgb(var(--color-surface-700) / 0.6);
    padding: 0.125rem 0.375rem;
    color: rgb(var(--theme-text-tertiary));
  }
}
