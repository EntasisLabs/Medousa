/**
 * Desktop status-strip marks.
 * Loaded by the destination feature entry; not imported from app.postcss.
 */

@layer features {


  /* Virtual desktops — soft index marks, not loud Omarchy pills. */
  .status-desktop-strip {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .status-desktop-mark {
    display: inline-flex;
    min-width: 1.1rem;
    height: 1.2rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    padding: 0 0.2rem;
    color: rgb(var(--theme-text-faint));
    font: inherit;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .status-desktop-mark:hover {
    background: rgb(var(--color-surface-800) / 0.5);
    color: rgb(var(--theme-text-secondary));
  }

  .status-desktop-mark--active {
    background: rgb(var(--color-surface-800) / 0.72);
    color: rgb(var(--color-surface-100));
  }

  .status-desktop-mark--active:hover {
    color: rgb(var(--color-surface-50));
  }

  .status-desktop-mark-index {
    opacity: 0.92;
  }

  .status-desktop-strip--compact {
    gap: 0.05rem;
  }

  .status-desktop-strip--compact .status-desktop-mark {
    min-width: 1rem;
    height: 1.1rem;
    padding: 0 0.15rem;
    font-size: 0.6rem;
  }

  /* Type-in-the-metal desktop marks (notch handle). */
  .status-desktop-strip--notch {
    gap: 0.05rem;
  }

  .status-desktop-strip--notch .status-desktop-mark {
    min-width: 0.85rem;
    height: auto;
    border-radius: 0;
    background: transparent;
    padding: 0 0.2rem;
    color: rgb(var(--color-surface-550, var(--color-surface-500)));
    font-size: 0.68rem;
    font-weight: 550;
  }

  .status-desktop-strip--notch .status-desktop-mark:hover {
    background: transparent;
    color: rgb(var(--color-surface-200));
  }

  .status-desktop-strip--notch .status-desktop-mark--active {
    background: transparent;
    color: rgb(var(--color-surface-50));
  }

  .status-desktop-strip--notch .status-desktop-mark--active:hover {
    color: rgb(var(--color-surface-50));
  }
}
