/**
 * Shared menu / popover density + type tokens.
 * Shared geometry for desktop menus. Keep labels at a readable UI size while
 * retaining the compact rhythm of titlebar menus.
 */

@layer base {
  html {
    --menu-panel-pad: 0.375rem;
    --menu-row-pad-y: 0.45rem;
    --menu-row-pad-x: 0.625rem;
    --menu-row-gap: 0.625rem;
    --menu-row-radius: 0.45rem;
    --menu-icon: 0.875rem;
    --menu-label-size: 0.8125rem;
    --menu-label-weight: 400;
    --menu-label-tracking: 0;
    --menu-meta-size: 0.6875rem;
    --menu-sep-margin: 0.3rem 0.375rem;
    --menu-radius: 0.75rem;
  }
}
