/* Create uses the same compact action dock as Notes and Code. */
.create-project-rail {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  color: rgb(var(--theme-text-secondary));
  font-size: 12px;
}
.create-rail-dock { min-width: 0; }
.create-rail-title { min-width: 0; flex: 1; padding-left: 4px; font-weight: 450; }
.create-rail-search { flex: 1; min-width: 0; width: 100%; color: rgb(var(--theme-text-quiet)); }
.create-rail-search input { width: 100%; flex: 1; min-width: 0; padding: 0; font: inherit; color: rgb(var(--theme-text)); }
.create-rail-search input::placeholder { color: rgb(var(--theme-text-quiet)); }
.create-root .create-rail-search input:focus-visible { outline: none; box-shadow: none; }
.create-rail-list { min-height: 0; flex: 1; overflow: auto; padding: 5px 8px 14px; scrollbar-gutter: stable; }
.create-rail-section {
  display: flex; align-items: center; gap: 5px; width: 100%; height: 27px;
  padding: 0 5px; margin-top: 6px; text-align: left; font-size: 11px; color: rgb(var(--theme-text-quiet));
}
.create-rail-section svg { transition: transform 120ms; }
.create-rail-collapsed { transform: rotate(-90deg); }
.create-rail-project { display: flex; align-items: center; min-height: 30px; border-radius: 5px; }
.create-rail-project:hover, .create-rail-project:focus-within, .create-rail-project.menu-open { background: rgb(var(--theme-text)/0.035); }
.create-rail-project.current { background: rgb(var(--theme-text)/0.065); color: rgb(var(--theme-text)); }
.create-rail-project-open { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; padding: 7px; text-align: left; font: inherit; }
.create-rail-project-open > svg, .create-rail-rename > svg { flex: none; color: rgb(var(--theme-text-tertiary)); }
.create-rail-project-open > span { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.create-rail-pin { color: rgb(var(--theme-text-quiet)); flex: none; margin-right: 2px; }
.create-rail-row-menu { opacity: 0; }
.create-rail-project:hover .create-rail-row-menu, .create-rail-project:focus-within .create-rail-row-menu, .create-rail-project.menu-open .create-rail-row-menu { opacity: 1; }
.create-rail-rename { display: flex; align-items: center; gap: 5px; width: 100%; padding-left: 7px; }
.create-rail-rename input { min-width: 0; width: 0; flex: 1; padding: 3px 0; background: transparent; border: 0; border-bottom: 1px solid rgb(var(--theme-text)/0.3); font: inherit; color: rgb(var(--theme-text)); }
.create-rail-mini { display: grid; place-items: center; width: 24px; height: 28px; flex: none; color: rgb(var(--theme-text-tertiary)); }
.create-rail-mini:hover { color: rgb(var(--theme-text)); }
.create-rail-confirm { margin: 4px 6px 8px; font-size: 11px; line-height: 1.5; }
.create-rail-confirm p { margin: 0 0 6px; overflow-wrap: anywhere; }
.create-rail-confirm > div { display: flex; justify-content: flex-end; gap: 12px; }
.create-rail-confirm button { padding: 4px 0; }
.create-rail-error { margin: 6px 12px; font-size: 11px; line-height: 1.5; color: rgb(var(--theme-text-secondary)); overflow-wrap: anywhere; }
.create-rail-error > button { margin-left: 8px; text-decoration: underline; }
.create-rail-empty { margin: 14px 7px; font-size: 11px; color: rgb(var(--theme-text-quiet)); }
.create-rail-load { padding: 10px 7px; color: rgb(var(--theme-text-tertiary)); font-size: 11px; }
.create-rail-menu { font: 12px/1.4 var(--font-sans, -apple-system, BlinkMacSystemFont, sans-serif); color: rgb(var(--theme-text-secondary)); }
.create-rail-menu > button {
  display: flex; align-items: center; gap: 8px; width: 100%; border: 0; border-radius: 5px;
  background: transparent; padding: 7px 8px; color: inherit; text-align: left; font: inherit;
}
.create-rail-menu > button:hover, .create-rail-menu > button:focus-visible { background: rgb(var(--theme-text)/0.065); outline: none; }
.create-rail-menu > button:disabled { opacity: .45; }
.create-rail-menu-label { padding: 5px 8px; font-size: 11px; color: rgb(var(--theme-text-quiet)); }
.create-rail-shortcut { margin-left: auto; color: rgb(var(--theme-text-quiet)); font-size: 11px; }
.create-rail-menu > .create-rail-danger, .create-rail-danger { color: rgb(var(--theme-error, 248 113 113)); }
@media (hover: none) { .create-rail-row-menu { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .create-rail-section svg { transition: none; } }
