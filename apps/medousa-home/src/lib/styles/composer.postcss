/**
 * Chat composer, voice, attachments, model picker.
 * Loaded by the destination feature entry; not imported from app.postcss.
 */

@layer features {


  .composer-bar-icon-btn {
    @apply flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-content-tertiary transition hover:bg-surface-700/60 hover:text-surface-200 disabled:pointer-events-none disabled:opacity-40;
  }


  .composer-footer-chip-wrap {
    @apply inline-flex max-w-[9rem] shrink-0 items-center gap-0.5;
  }

  .composer-footer-chip {
    @apply inline-flex min-w-0 max-w-[8rem] items-center gap-1 rounded-full border border-surface-500/35 bg-surface-900/55 px-2 py-0.5 text-[11px] text-content-secondary transition hover:border-primary-500/35 hover:text-surface-100;
  }

  .composer-footer-chip-mono {
    @apply flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-surface-700 text-[9px] font-semibold text-surface-200;
  }

  .composer-footer-chip-dismiss {
    @apply flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-content-quiet transition hover:bg-surface-700/70 hover:text-surface-200;
  }

  .composer-anchored-menu {
    /* Above shell chrome; matches slash menu so body-portaled menus stay selectable. */
    @apply z-[220] flex min-w-[16rem] max-w-[20rem] flex-col overflow-hidden rounded-xl;
    position: fixed;
    top: 0;
    left: 0;
    border: 1px solid rgb(var(--color-surface-600) / 0.35);
    background: rgb(var(--color-surface-900) / 0.98);
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.35),
      0 0 0 1px rgb(0 0 0 / 0.12);
    backdrop-filter: blur(16px);
  }

  .composer-anchored-menu-header {
    @apply shrink-0 border-b border-surface-700/40 px-3 py-2.5;
  }

  .composer-anchored-menu-body {
    @apply min-h-0 flex-1 overflow-y-auto px-2 py-2;
  }

  .composer-plus-menu-panel {
    @apply min-w-[12.5rem] py-1;
  }

  .composer-plus-menu-item {
    @apply flex w-full items-center text-left transition hover:bg-surface-800/70;
    gap: var(--menu-row-gap, 0.55rem);
    padding: var(--menu-row-pad-y, 0.45rem) var(--menu-row-pad-x, 0.55rem);
    font-size: var(--menu-label-size, var(--chrome-xs, 11px));
    font-weight: var(--menu-label-weight, 500);
    letter-spacing: var(--menu-label-tracking, -0.01em);
    color: rgb(var(--color-surface-200));
    border-radius: var(--menu-row-radius, 0.45rem);
  }

  .composer-plus-menu-dot {
    @apply h-2 w-2 shrink-0 rounded-full bg-primary-400;
  }

  .composer-bar-voice-btn {
    @apply opacity-80;
  }

  .composer-bar-voice-btn-active {
    @apply text-content-error opacity-100;
    background-color: rgb(var(--color-error-500) / 0.18);
    box-shadow: 0 0 0 2px rgb(var(--color-error-500) / 0.25);
    animation: composer-voice-pulse 1.4s ease-in-out infinite;
  }

  @keyframes composer-voice-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  .composer-attachment-chips {
    @apply mx-8 mb-2 flex flex-wrap items-end gap-2;
  }

  .composer-voice-status {
    @apply mx-8 mb-1.5 text-xs text-content-tertiary;
  }

  .composer-voice-status-error {
    @apply text-content-error/90;
  }

  .composer-voice-recorder {
    @apply flex min-h-[40px] w-full min-w-0 flex-1 items-center gap-2 py-0.5;
  }

  .composer-voice-attach {
    @apply opacity-70;
  }

  .composer-voice-stage {
    @apply flex min-w-0 flex-1 items-center gap-2.5 px-1;
  }

  .composer-voice-live {
    @apply relative flex h-3 w-3 shrink-0 items-center justify-center;
  }

  .composer-voice-live-core {
    @apply relative z-[1] h-[7px] w-[7px] rounded-full;
    background: rgb(var(--color-error-400));
    box-shadow: 0 0 10px rgb(var(--color-error-500) / 0.55);
  }

  .composer-voice-live-ring {
    @apply absolute inset-0 rounded-full;
    background: rgb(var(--color-error-500) / 0.22);
    animation: composer-voice-live-ring 1.6s ease-out infinite;
  }

  @keyframes composer-voice-live-ring {
    0% {
      transform: scale(0.72);
      opacity: 0.85;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  .composer-voice-wave-wrap {
    @apply flex h-7 min-w-0 flex-1 items-center justify-center overflow-hidden;
  }

  .composer-voice-wave {
    @apply flex h-full min-w-0 flex-1 items-center justify-center gap-[3px];
  }

  .composer-voice-wave-bar {
    @apply w-[3px] shrink-0 rounded-full;
    background: linear-gradient(
      to top,
      rgb(var(--color-error-500) / 0.35),
      rgb(var(--color-error-300) / 0.92)
    );
    transition:
      height 90ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 90ms ease;
  }

  .composer-voice-meta {
    @apply flex shrink-0 items-center gap-1.5 pl-0.5;
  }

  .composer-voice-phase {
    @apply text-[11px] font-medium uppercase tracking-[0.14em] text-content-tertiary;
  }

  .composer-voice-meta-dot {
    @apply text-[10px] text-content-faint;
  }

  .composer-voice-timer {
    @apply tabular-nums text-xs font-medium text-content-secondary;
  }

  .composer-voice-actions {
    @apply flex shrink-0 items-center gap-1;
  }

  .composer-voice-cancel {
    @apply flex h-8 w-8 items-center justify-center rounded-full text-content-quiet transition hover:bg-surface-700/55 hover:text-surface-100 disabled:pointer-events-none disabled:opacity-40;
  }

  .composer-voice-done {
    @apply flex h-8 w-8 items-center justify-center rounded-full text-surface-50 transition-all duration-200 ease-out disabled:pointer-events-none disabled:opacity-45;
    background-color: rgb(var(--color-primary-500));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.22),
      0 0 12px rgb(var(--color-primary-500) / 0.28);
  }

  .composer-voice-done:not(:disabled):active {
    transform: scale(0.92);
  }

  .composer-voice-recorder-starting .composer-voice-live-core,
  .composer-voice-recorder-starting .composer-voice-live-ring {
    @apply opacity-60;
    animation: none;
  }

  .composer-voice-recorder-finishing .composer-voice-wave-bar {
    opacity: 0.35;
  }

  .composer-voice-recorder-transcribing .composer-voice-live-core {
    background: rgb(var(--color-primary-400));
    box-shadow: 0 0 10px rgb(var(--color-primary-500) / 0.5);
    animation: composer-voice-live-breathe 1.4s ease-in-out infinite;
  }

  .composer-voice-recorder-transcribing .composer-voice-live-ring {
    background: rgb(var(--color-primary-500) / 0.2);
    animation: composer-voice-live-ring 1.8s ease-out infinite;
  }

  .composer-voice-recorder-transcribing .composer-voice-wave-bar {
    background: linear-gradient(
      to top,
      rgb(var(--color-primary-500) / 0.25),
      rgb(var(--color-primary-300) / 0.55)
    );
    animation: composer-voice-bar-shimmer 1.6s ease-in-out infinite;
  }

  .composer-voice-recorder-transcribing .composer-voice-phase {
    @apply text-content-link/90;
  }

  @keyframes composer-voice-live-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.12);
    }
  }

  @keyframes composer-voice-bar-shimmer {
    0%,
    100% {
      opacity: 0.28;
    }
    50% {
      opacity: 0.55;
    }
  }

  .composer-bar-voice-mode {
    border-color: rgb(var(--color-error-500) / 0.28);
    background-color: rgb(var(--color-surface-800) / 0.78);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 0 0 1px rgb(var(--color-error-500) / 0.08),
      0 0 22px rgb(var(--color-error-500) / 0.07);
  }

  .composer-bar-voice-mode.composer-bar-voice-transcribing {
    border-color: rgb(var(--color-primary-500) / 0.32);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 0 0 1px rgb(var(--color-primary-500) / 0.1),
      0 0 24px rgb(var(--color-primary-500) / 0.1);
  }

  .composer-voice-recorder-mobile .composer-voice-phase {
    @apply text-[10px];
  }

  .composer-voice-recorder-mobile .composer-voice-timer {
    @apply text-[11px];
  }
  @media (prefers-reduced-motion: reduce) {
    .composer-voice-live-ring,
    .composer-voice-live-core,
    .composer-voice-wave-bar {
      animation: none !important;
    }  }


  .mobile-chat-composer .composer-voice-status {
    @apply mx-3;
  }

  .mobile-chat-composer .composer-attachment-chips {
    @apply mx-3 mb-1;
  }

  .composer-attachment-chip {
    @apply inline-flex max-w-[min(100%,220px)] items-center gap-0.5 rounded-full border border-surface-500/40 bg-surface-800/70 py-0.5 pl-2.5 pr-1 text-xs text-primary-200;
  }

  .composer-attachment-chip-remove {
    @apply inline-flex h-5 w-5 items-center justify-center rounded-full text-content-quiet hover:bg-surface-700 hover:text-surface-200 disabled:opacity-40;
  }

  .composer-attachment-preview {
    @apply relative m-0 w-[5.5rem] overflow-hidden rounded-xl border border-surface-500/40 bg-surface-900/80;
    box-shadow: 0 5px 16px rgb(var(--color-surface-950) / 0.22);
  }

  .composer-attachment-preview-image {
    @apply block h-[4.25rem] w-full object-cover;
  }

  .composer-attachment-preview-label {
    @apply truncate border-t border-surface-600/35 px-2 py-1 text-[10px] leading-tight text-content-tertiary;
  }

  .composer-attachment-preview-remove {
    @apply absolute right-1 top-1 inline-flex h-5 w-5 items-center justify-center rounded-full border border-surface-500/45 text-surface-200 shadow-sm transition hover:bg-surface-800 disabled:opacity-40;
    background: rgb(var(--color-surface-950) / 0.85);
    backdrop-filter: blur(8px);
  }

  .composer-model-picker {
    @apply relative shrink-0;
  }

  /* Blended into composer chrome — text + chevron, no chip. */
  .composer-model-trigger {
    @apply inline-flex max-w-[12rem] items-center gap-1.5 rounded-md px-1.5 py-1 text-left transition-colors duration-150 disabled:pointer-events-none disabled:opacity-45;
    border: 1px solid transparent;
    background: transparent;
  }

  .composer-model-trigger:hover:not(:disabled) {
    border-color: transparent;
    background: transparent;
  }

  .composer-model-trigger-open {
    border-color: transparent;
    background: transparent;
  }

  .composer-model-trigger--quiet {
    @apply max-w-[11rem];
  }

  .composer-model-trigger--quiet .composer-model-trigger-name {
    @apply text-[12px] font-normal;
    color: rgb(var(--theme-text-tertiary));
  }

  .composer-model-trigger:hover:not(:disabled) .composer-model-trigger-name,
  .composer-model-trigger-open .composer-model-trigger-name,
  .composer-model-trigger--quiet:hover:not(:disabled) .composer-model-trigger-name,
  .composer-model-trigger--quiet.composer-model-trigger-open .composer-model-trigger-name {
    @apply text-surface-200;
  }

  .composer-model-trigger-readonly {
    @apply cursor-default;
  }

  .composer-model-trigger-copy {
    @apply min-w-0 flex-1 leading-none;
  }

  .composer-model-trigger-name {
    @apply block truncate text-[13px] font-medium text-surface-200;
    letter-spacing: -0.01em;
  }

  .composer-model-trigger-meta {
    @apply mt-0.5 block truncate text-[10px];
    color: rgb(var(--theme-text-quiet));
  }

  .composer-model-trigger-chevron {
    @apply shrink-0 transition-transform duration-150;
    color: rgb(var(--theme-text-quiet));
  }

  .composer-model-trigger-open .composer-model-trigger-chevron {
    transform: rotate(180deg);
  }

  .composer-model-trigger-spinner {
    @apply shrink-0 text-content-tertiary;
  }

  .composer-model-panel {
    @apply absolute bottom-full left-0 z-50 mb-2 rounded-xl overflow-hidden;
    width: min(27rem, calc(100vw - 1rem));
    border: 1px solid rgb(var(--theme-border) / 0.68);
    background: rgb(var(--theme-pane));
    box-shadow:
      0 16px 42px rgb(0 0 0 / 0.3),
      0 0 0 1px rgb(0 0 0 / 0.08);
  }

  .composer-model-panel-search {
    @apply border-b px-3;
    border-color: rgb(var(--theme-border) / 0.52);
  }

  .composer-model-source {
    @apply border-b border-surface-700/35 px-2.5 pb-2 pt-2.5;
  }

  .composer-model-source-current {
    @apply flex items-center justify-between gap-3 px-1 pb-2;
  }

  .composer-model-source-kicker {
    @apply text-[10px] font-semibold uppercase tracking-[0.12em] text-content-quiet;
  }

  .composer-model-source-summary {
    @apply min-w-0 truncate text-[10px] text-content-tertiary;
  }

  .composer-model-source-list {
    @apply space-y-0.5;
  }

  .composer-model-source-option {
    @apply flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-left transition-colors;
  }

  .composer-model-source-option:hover {
    background: rgb(var(--color-surface-800) / 0.55);
  }

  .composer-model-source-option-active {
    background: rgb(var(--color-surface-800) / 0.42);
  }

  .composer-model-source-option-locked {
    @apply text-content-quiet;
  }

  .composer-model-source-icon {
    @apply flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-content-tertiary;
    background: rgb(var(--color-surface-800) / 0.58);
  }

  .composer-model-source-copy {
    @apply flex min-w-0 flex-1 flex-col;
  }

  .composer-model-source-name {
    @apply text-[12px] font-medium text-surface-100;
  }

  .composer-model-source-detail {
    @apply truncate text-[10px] text-content-quiet;
  }

  .composer-model-source-state {
    @apply shrink-0 text-content-link;
  }

  .composer-model-provider-nav {
    @apply flex min-w-0 border-b;
    border-color: rgb(var(--theme-border) / 0.42);
  }

  .composer-model-provider-strip {
    @apply flex min-w-0 flex-1 gap-1 overflow-x-auto py-2 pl-2.5 pr-1;
    scrollbar-width: none;
  }

  .composer-model-provider-strip::-webkit-scrollbar {
    display: none;
  }

  .composer-model-provider-option {
    @apply inline-flex shrink-0 items-center gap-1.5 rounded-md text-[10.5px] font-medium text-content-quiet transition-colors;
    font-size: 10.5px !important;
    padding: 0.32rem 0.58rem !important;
  }

  .composer-model-provider-option:hover {
    @apply text-content-secondary;
    background: rgb(var(--color-surface-800) / 0.5);
  }

  .composer-model-provider-option-active {
    @apply text-surface-100;
    background: rgb(var(--color-surface-800) / 0.72);
    box-shadow: inset 0 0 0 1px rgb(var(--theme-border) / 0.5);
  }

  .composer-model-provider-pager {
    @apply flex shrink-0 items-center gap-px px-1.5;
    border-left: 1px solid rgb(var(--theme-border) / 0.34);
    background: rgb(var(--theme-pane));
  }

  .composer-model-provider-page {
    @apply inline-flex h-6 w-5 items-center justify-center rounded text-content-tertiary transition-colors disabled:opacity-25;
    padding: 0 !important;
  }

  .composer-model-provider-page:hover:not(:disabled) {
    @apply text-surface-100;
    background: rgb(var(--color-surface-800) / 0.62);
  }

  .composer-model-search {
    @apply flex h-11 w-full items-center gap-2.5;
    display: flex !important;
  }

  .composer-model-search-icon {
    @apply shrink-0 text-content-quiet;
  }

  .composer-model-search-input {
    @apply min-w-0 flex-1 border-0 bg-transparent font-normal text-surface-200 placeholder:text-content-tertiary focus:outline-none;
    font-size: 12.5px !important;
    letter-spacing: -0.012em;
  }

  .composer-model-list {
    @apply max-h-[17.5rem] overflow-y-auto px-1.5 py-1.5;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-surface-600) / 0.5) transparent;
  }

  .composer-model-list-item {
    @apply flex min-h-[2.8rem] w-full items-center rounded-md text-left transition-colors;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem !important;
  }

  .composer-model-list-item:hover,
  .composer-model-list-item-highlighted {
    background: rgb(var(--color-surface-800) / 0.62);
  }

  .composer-model-list-item-active {
    background: rgb(var(--color-surface-800) / 0.28);
  }

  .composer-model-list-name {
    @apply min-w-0 flex-1 truncate text-surface-200;
    font-size: var(--menu-label-size, var(--chrome-xs, 11px));
    font-weight: var(--menu-label-weight, 500);
    letter-spacing: var(--menu-label-tracking, -0.01em);
  }

  .composer-model-row-copy {
    @apply flex min-w-0 flex-1 flex-col gap-[0.18rem];
  }

  .composer-model-row-name {
    @apply truncate text-surface-200;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: -0.012em;
  }

  .composer-model-row-meta {
    @apply truncate leading-tight text-content-tertiary;
    font-size: 10px;
    letter-spacing: -0.005em;
  }

  .composer-model-row-cap {
    @apply inline-flex shrink-0 items-center gap-1 text-[9.5px] font-normal text-content-quiet;
  }

  .composer-model-list-check {
    @apply shrink-0 text-content-secondary;
  }

  .composer-model-list-empty {
    @apply flex min-h-36 flex-col items-center justify-center gap-2 px-5 py-8 text-center text-[11px] text-content-quiet;
  }

  .composer-model-connect {
    @apply rounded-md border border-surface-600/45 px-2.5 py-1 text-[11px] font-medium text-content-secondary transition-colors;
  }

  .composer-model-connect:hover {
    @apply border-surface-500/60 bg-surface-800/55 text-surface-100;
  }

  .composer-model-mobile-note {
    @apply border-b border-surface-700/40 px-3.5 py-3.5;
  }

  .composer-model-mobile-title {
    @apply text-sm font-medium text-surface-200;
  }

  .composer-model-mobile-copy {
    @apply mt-1 text-xs text-content-quiet;
  }

  .composer-model-panel-footer {
    @apply flex w-full items-center justify-between gap-2 border-t text-left text-[10.5px] text-content-quiet transition hover:bg-surface-800/40 hover:text-content-secondary;
    border-color: rgb(var(--theme-border) / 0.46);
    font-size: 10.5px !important;
    line-height: 1.25 !important;
    padding: 0.55rem 0.75rem !important;
  }

  .composer-skill-pills {
    @apply flex flex-wrap items-center gap-1.5;
  }

  .composer-skill-pill {
    @apply inline-flex max-w-[14rem] items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-medium shadow-sm backdrop-blur-sm;
  }

  .composer-skill-pill-skill {
    @apply border-primary-500/35 bg-surface-900/90 text-primary-100;
  }

  .composer-skill-pill-tool {
    @apply border-secondary-500/35 bg-surface-900/90 text-secondary-100;
  }

  .composer-skill-pill-remove {
    @apply -mr-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-content-tertiary transition hover:bg-surface-700/80 hover:text-surface-50 disabled:opacity-40;
  }

  .composer-skill-slash-menu {
    @apply fixed z-[220] flex w-[min(calc(100vw-1rem),20rem)] flex-col gap-0.5 overflow-x-hidden overflow-y-auto rounded-xl border border-surface-600/40 bg-surface-900/95 p-1.5 shadow-2xl backdrop-blur-md;
    overscroll-behavior: contain;
  }

  .composer-skill-slash-section {
    @apply px-2 pb-1 pt-2 text-[11px] font-medium tracking-[-0.01em] text-content-quiet first:pt-1;
  }

  .composer-skill-slash-row {
    @apply flex w-full items-center gap-2.5 rounded-lg px-2 py-1.5 text-left transition;
  }

  .composer-skill-slash-row:hover,
  .composer-skill-slash-row-active {
    @apply bg-surface-800/85;
  }

  .composer-skill-slash-icon {
    @apply flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-surface-800/80 text-content-tertiary;
  }

  .composer-skill-slash-row-active .composer-skill-slash-icon {
    @apply bg-surface-700/90 text-surface-200;
  }

  .composer-skill-slash-copy {
    @apply flex min-w-0 flex-1 flex-col gap-0.5;
  }

  .composer-skill-slash-label {
    @apply truncate text-[13px] font-medium tracking-[-0.01em] text-surface-100;
  }

  .composer-skill-slash-hint {
    @apply truncate text-[11px] leading-snug text-content-quiet;
  }

  /* iMessage-style growing composer */
  .composer-bar {
    @apply flex items-end gap-1.5 rounded-[22px] px-2 py-1 transition-[border-radius,background-color,box-shadow,border-color,transform] duration-200 ease-out;
    border: 1px solid rgb(var(--color-surface-600) / 0.42);
    background-color: rgb(var(--color-surface-800) / 0.65);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 1px 2px rgb(0 0 0 / 0.16);
  }

  /* Cursor-quiet stacked composer: textarea above, compact footer below */
  .composer-bar.composer-bar-stacked {
    @apply flex-col items-stretch gap-0.5 px-2 py-1.5;
  }

  .composer-bar.composer-bar-stacked .composer-bar-stacked-input {
    /* The stacked desktop composer must honor GrowingTextarea's measured
       height. Its shared base class is flex-1, which makes a column flex
       parent shrink the textarea back to its one-line flex basis. */
    @apply w-full min-w-0 flex-none px-1.5 pt-0.5;
  }

  .composer-bar-footer {
    @apply flex min-w-0 items-center gap-1;
  }

  .composer-bar-footer-spacer {
    @apply min-w-0 flex-1;
  }

  /* Satellites under the box — quieter than the runtime lead. */
  .composer-turn-controls {
    @apply relative flex min-w-0 items-center gap-2;
  }

  .composer-turn-trigger {
    @apply inline-flex max-w-full items-center gap-1 rounded-md px-1 py-0.5 text-[11px] transition-colors duration-150;
    border: 1px solid transparent;
    background: transparent;
    color: rgb(var(--theme-text-tertiary));
  }

  .composer-turn-trigger:hover:not(:disabled),
  .composer-turn-trigger-open {
    @apply text-content-tertiary;
  }

  .composer-turn-trigger:disabled {
    @apply pointer-events-none opacity-45;
  }

  .composer-turn-trigger-icon {
    @apply shrink-0 opacity-60;
  }

  .composer-turn-trigger-label {
    @apply max-w-[4.5rem] truncate font-medium;
  }

  /* Chevron reserved in layout; only peeks on hover / open. */
  .composer-turn-trigger-chevron {
    @apply shrink-0 opacity-0 transition-[opacity,transform] duration-150;
  }

  .composer-turn-trigger:hover:not(:disabled) .composer-turn-trigger-chevron,
  .composer-turn-trigger-open .composer-turn-trigger-chevron {
    @apply opacity-50;
  }

  .composer-turn-trigger-open .composer-turn-trigger-chevron {
    transform: rotate(180deg);
  }

  .composer-turn-menu {
    @apply min-w-[11rem] max-w-[14rem];
  }

  .composer-turn-option {
    @apply flex w-full items-center gap-2 rounded-lg px-2.5 py-1.5 text-left text-[13px] text-content-secondary transition hover:bg-surface-800/70 hover:text-surface-100;
  }

  .composer-turn-option-active {
    @apply bg-surface-800/55 text-surface-100;
  }

  .composer-turn-option-label {
    @apply min-w-0 flex-1 truncate;
  }

  .composer-turn-option-check {
    @apply shrink-0 text-content-link;
  }

  .composer-bar:focus-within {
    border-color: rgb(var(--color-primary-500) / 0.42);
    background-color: rgb(var(--color-surface-800) / 0.82);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 0 0 3px rgb(var(--color-primary-500) / 0.14),
      0 2px 10px rgb(0 0 0 / 0.2);
  }

  .composer-bar:has(.composer-bar-input[data-expanded="true"]) {
    @apply rounded-[20px] py-1.5;
  }

  .composer-bar-mobile {
    @apply gap-1.5 rounded-[22px] px-1.5 py-0.5;
    border-color: rgb(var(--color-surface-600) / 0.48);
    background-color: rgb(var(--color-surface-800) / 0.78);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      inset 0 -1px 0 rgb(0 0 0 / 0.12),
      0 1px 3px rgb(0 0 0 / 0.2);
  }

  .composer-bar-mobile:focus-within {
    border-color: rgb(var(--color-surface-500) / 0.58);
    background-color: rgb(var(--color-surface-800) / 0.92);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.09),
      0 0 0 3px rgb(var(--color-primary-500) / 0.14),
      0 4px 16px rgb(0 0 0 / 0.22);
  }

  .composer-bar-mobile:has(.composer-bar-input[data-expanded="true"]) {
    @apply rounded-[22px] py-1.5;
  }

  .composer-bar-input {
    @apply min-h-[36px] max-h-[25rem] flex-1 resize-none border-0 bg-transparent py-2 pl-2.5 pr-1 text-sm leading-[1.35] text-surface-50 shadow-none placeholder:text-content-tertiary focus:border-0 focus:outline-none focus:ring-0;
    -webkit-font-smoothing: antialiased;
  }

  .composer-bar-mobile .composer-bar-input {
    @apply min-h-[34px] py-1.5 pl-3 pr-0.5 text-base leading-snug;
    letter-spacing: -0.01em;
  }

  .composer-bar-mobile .composer-bar-input::placeholder {
    color: rgb(var(--theme-text-tertiary) / 0.85);
  }

  .composer-bar-send {
    @apply mb-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[15px] font-semibold transition-all duration-200 ease-out;
    background-color: rgb(var(--color-surface-600) / 0.55);
    color: rgb(var(--theme-text-tertiary));
  }

  .composer-bar-send:disabled {
    opacity: 0.55;
    transform: scale(0.94);
  }

  .composer-bar-send:not(:disabled) {
    background-color: rgb(var(--color-primary-500));
    color: rgb(var(--on-primary));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.2),
      0 0 12px rgb(var(--color-primary-500) / 0.28);
    transform: scale(1);
  }

  .composer-bar-send:not(:disabled):active {
    transform: scale(0.92);
  }

  .composer-bar-stop,
  .composer-bar-stop:not(:disabled) {
    background-color: rgb(var(--color-error-500) / 0.9);
    color: rgb(var(--color-surface-50));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.2),
      0 0 12px rgb(var(--color-error-500) / 0.22);
  }

  .composer-bar-mobile .composer-bar-send {
    @apply mb-0 h-11 w-11 text-sm;
    transition:
      transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      opacity 0.2s ease;
  }

  .mobile-composer-dock-input.composer-bar-input {
    @apply w-full max-h-[22.5rem] min-h-[34px] flex-none resize-none border-0 bg-transparent py-1.5 pl-1 pr-1 text-base leading-snug text-surface-50 shadow-none placeholder:text-content-tertiary focus:border-0 focus:outline-none focus:ring-0;
    flex: 0 0 auto;
    letter-spacing: -0.01em;
  }

  .mobile-composer-dock-input.composer-bar-input::placeholder {
    color: rgb(var(--theme-text-tertiary) / 0.85);
  }

  .mobile-composer-dock .composer-bar-send {
    @apply mb-0 h-11 w-11 shrink-0 text-sm;
  }

  .composer-bar-send-text {
    @apply h-11 w-auto min-w-[3.25rem] px-3.5 text-xs font-semibold;
  }

  .cron-create-form-mobile :is(.cron-field-input, .composer-bar-input),
  .cron-panel-mobile :is(.cron-search-input, .composer-bar-input) {
    font-size: 16px;
    line-height: 1.35;
  }
}
