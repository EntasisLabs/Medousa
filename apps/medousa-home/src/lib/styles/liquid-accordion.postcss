@layer features {

  .liquid-accordion {
    margin: 0;
    padding: 0.75rem 0.85rem 0.9rem;
    border-radius: 0.85rem;
    border: 1px solid color-mix(in srgb, rgb(var(--color-surface-500)) 28%, transparent);
    background: color-mix(in srgb, rgb(var(--color-surface-900)) 48%, transparent);
    min-width: 0;
  }

  .liquid-accordion-header {
    margin-bottom: 0.65rem;
  }

  .liquid-accordion-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    color: rgb(var(--color-surface-50));
  }

  .liquid-accordion-subtitle {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--theme-text-tertiary));
  }

  .liquid-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .liquid-accordion-item {
    border-radius: 0.55rem;
    border: 1px solid color-mix(in srgb, rgb(var(--color-surface-500)) 22%, transparent);
    background: color-mix(in srgb, rgb(var(--color-surface-950)) 40%, transparent);
    overflow: hidden;
  }

  .liquid-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border: 0;
    background: transparent;
    color: rgb(var(--color-surface-100));
    text-align: left;
    cursor: pointer;
  }

  .liquid-accordion-label-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .liquid-accordion-emoji {
    font-size: 0.95rem;
    line-height: 1;
  }

  .liquid-accordion-label {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .liquid-accordion-chevron {
    flex: 0 0 auto;
    font-size: 0.7rem;
    color: rgb(var(--theme-text-tertiary));
    transition: transform 0.18s ease;
  }

  .liquid-accordion-open .liquid-accordion-chevron,
  .liquid-accordion-item[open] > .liquid-accordion-trigger .liquid-accordion-chevron {
    transform: rotate(180deg);
  }

  .liquid-accordion-panel {
    padding: 0 0.7rem 0.65rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgb(var(--theme-text-secondary));
  }

  .liquid-accordion-body :is(p) {
    margin: 0 0 0.45rem;
  }

  .liquid-accordion-body :is(p:last-child) {
    margin-bottom: 0;
  }

  .liquid-accordion-body :is(ul),
  .liquid-accordion-body :is(ol) {
    margin: 0.2rem 0 0.45rem;
    padding-left: 1.15rem;
  }

  .liquid-accordion-body :is(li + li) {
    margin-top: 0.2rem;
  }

  .liquid-accordion-body :is(a) {
    color: color-mix(in srgb, rgb(var(--color-primary-400)) 88%, white);
  }

  @media (prefers-reduced-motion: reduce) {
    .liquid-accordion-chevron {
      transition: none;
    }
  }

  details.liquid-accordion-item > summary { list-style:none; }
  details.liquid-accordion-item > summary::-webkit-details-marker { display:none; }
  details.liquid-accordion-item > summary::marker { content:""; }
  .liquid-accordion-trigger:focus-visible { outline:2px solid rgb(var(--theme-link)); outline-offset:-2px; }

}
