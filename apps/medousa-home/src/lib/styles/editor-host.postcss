/**
 * Shared CodeMirror host chrome.
 * Loaded by CodeMirrorHost so Code and Scripts both get structural editor CSS
 * without depending on vault-editor or scripts destination sheets.
 */

@layer features {
  .grapheme-codemirror-host {
    @apply min-h-0 flex-1 overflow-hidden;
    background-color: rgb(var(--color-surface-950) / 0.72);
  }

  .grapheme-codemirror-host .cm-editor {
    @apply h-full outline-none;
  }

  .grapheme-codemirror-host .cm-scroller {
    @apply min-h-0 flex-1 overflow-auto font-mono leading-relaxed;
    font-size: calc(13px * var(--content-zoom, 1));
  }
}
