/**
 * Shell tab notch / drawer chrome.
 * Loaded by the destination feature entry; not imported from app.postcss.
 */

@layer features {


  /* Calm workspace popover under the app-bar workspace trigger. */
  .shell-tab-notch-drawer {
    z-index: 145;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(var(--color-surface-500) / 0.36);
    border-radius: 0.55rem;
    background: rgb(var(--color-surface-900) / 0.98);
    backdrop-filter: blur(14px);
    box-shadow: 0 14px 32px rgb(0 0 0 / 0.28);
    animation: shell-tab-notch-open 150ms ease-out;
  }

  .shell-tab-notch-drawer-footer {
    display: flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
  }

  .shell-tab-notch-drawer-footer {
    border-top: 1px solid rgb(var(--color-surface-500) / 0.24);
    padding: 0.65rem 0.75rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.64rem;
    font-weight: 550;
  }

  .shell-tab-notch-drawer-footer-divider {
    width: 1px;
    height: 0.9rem;
    margin: 0 0.25rem;
    background: rgb(var(--color-surface-500) / 0.22);
  }

  .shell-tab-notch-drawer-quiet-action,
  .shell-tab-notch-drawer-desktop-actions button {
    display: inline-flex;
    width: 1.65rem;
    height: 1.65rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.38rem;
    background: transparent;
    color: rgb(var(--color-surface-300));
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .shell-tab-notch-drawer-desktop-actions {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.1rem;
  }

  .shell-tab-notch-drawer-quiet-action:hover:not(:disabled),
  .shell-tab-notch-drawer-desktop-actions button:hover:not(:disabled) {
    background: rgb(var(--color-surface-800) / 0.65);
    color: rgb(var(--color-surface-100));
  }

  .shell-tab-notch-drawer button:disabled {
    opacity: 0.32;
    cursor: default;
  }

  .shell-tab-notch-drawer-desktop-copy {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
  }

  .shell-tab-notch-drawer-desktop-name,
  .shell-tab-notch-drawer-desktop-name-input {
    min-width: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    padding: 0;
    color: rgb(var(--color-surface-100));
    font-size: 0.76rem;
    font-weight: 600;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shell-tab-notch-drawer-desktop-name-input {
    border-bottom: 1px solid rgb(var(--color-surface-400) / 0.45);
    outline: none;
  }

  .shell-tab-notch-drawer-desktop-copy > span:last-child {
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.66rem;
  }

  .shell-tab-notch-drawer-desktop-actions button {
    font-size: 0.66rem;
  }

  .shell-tab-notch-drawer-desktop-actions button.active {
    background: rgb(var(--color-surface-700) / 0.8);
    color: rgb(var(--color-surface-50));
  }

  @keyframes shell-tab-notch-open {
    from {
      opacity: 0.75;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shell-tab-notch-drawer-stage {
    display: flex;
    height: 7.5rem;
    min-height: 7.5rem;
    flex: 0 0 auto;
    flex-direction: column;
    overflow: hidden;
    padding: 0.6rem;
  }

  .shell-tab-notch-drawer--single .shell-tab-notch-drawer-stage {
    height: 5.5rem;
    min-height: 5.5rem;
  }

  .shell-tab-notch-drawer--search {
    display: flex;
    min-height: 8rem;
    max-height: inherit;
    flex-direction: column;
    overflow: hidden;
  }

  .shell-tab-notch-search {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    overflow: hidden;
  }

  .shell-tab-notch-search-list {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.1rem;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0.3rem;
    scrollbar-width: thin;
  }

  .shell-tab-notch-search-empty {
    padding: 1.1rem 0.75rem;
    color: rgb(var(--theme-text-quiet));
    font-size: 0.75rem;
    text-align: center;
  }

  .shell-tab-notch-search-group + .shell-tab-notch-search-group {
    margin-top: 0.35rem;
  }

  .shell-tab-notch-search-group-label {
    padding: 0.25rem 0.4rem 0.2rem;
    color: rgb(var(--theme-text-quiet));
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .shell-tab-notch-search-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    padding: 0.35rem 0.4rem;
    color: rgb(var(--color-surface-200));
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .shell-tab-notch-search-row:hover,
  .shell-tab-notch-search-row--hl {
    background: rgb(var(--color-surface-800) / 0.65);
  }

  .shell-tab-notch-search-row--active .shell-tab-notch-search-title {
    color: rgb(var(--color-surface-50));
  }

  .shell-tab-notch-search-icon {
    flex-shrink: 0;
    color: rgb(var(--theme-text-tertiary));
  }

  .shell-tab-notch-search-row--hl .shell-tab-notch-search-icon,
  .shell-tab-notch-search-row--active .shell-tab-notch-search-icon {
    color: rgb(var(--color-surface-200));
  }

  .shell-tab-notch-search-title {
    min-width: 0;
    overflow: hidden;
    color: rgb(var(--color-surface-100));
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shell-tab-notch-search-meta {
    min-width: 0;
    overflow: hidden;
    color: rgb(var(--theme-text-quiet));
    font-size: 0.625rem;
    font-weight: 450;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shell-tab-notch-branch {
    display: flex;
    min-height: 100%;
    min-width: 0;
    flex: 1 1 auto;
    gap: 0.35rem;
    overflow: hidden;
  }

  .shell-tab-notch-branch--row {
    flex-direction: row;
  }

  .shell-tab-notch-branch--col {
    flex-direction: column;
  }

  .shell-tab-notch-branch-child {
    display: flex;
    min-height: 0;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
  }

  .shell-tab-notch-branch-sash {
    flex: 0 0 0;
    background: transparent;
  }

  .shell-tab-notch-branch--col > .shell-tab-notch-branch-sash {
    flex-basis: 0;
    width: auto;
    min-height: 0;
  }

  .shell-tab-notch-pane {
    display: flex;
    min-height: 0;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(var(--color-surface-500) / 0.3);
    border-radius: 0.4rem;
    background: rgb(var(--color-surface-950) / 0.62);
    cursor: pointer;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      box-shadow 140ms ease;
  }

  .shell-tab-notch-pane:hover {
    border-color: rgb(var(--color-surface-500) / 0.38);
  }

  .shell-tab-notch-pane--active {
    border-color: rgb(var(--color-surface-400) / 0.42);
    background: rgb(var(--color-surface-950) / 0.78);
    box-shadow: 0 0 0 1px rgb(var(--color-surface-400) / 0.09);
  }

  .shell-tab-notch-pane-chrome {
    display: flex;
    height: 1.65rem;
    flex: 0 0 1.65rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgb(var(--color-surface-500) / 0.2);
    padding: 0 0.4rem 0 0.5rem;
    color: rgb(var(--theme-text-tertiary));
    font-size: 0.57rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .shell-tab-notch-pane-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.05rem;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .shell-tab-notch-pane:hover .shell-tab-notch-pane-actions,
  .shell-tab-notch-pane:focus-within .shell-tab-notch-pane-actions,
  .shell-tab-notch-pane:focus .shell-tab-notch-pane-actions {
    opacity: 1;
  }

  .shell-tab-notch-pane-actions button {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: rgb(var(--theme-text-tertiary));
  }

  .shell-tab-notch-pane-actions button:hover:not(:disabled) {
    background: rgb(var(--color-surface-700) / 0.75);
    color: rgb(var(--color-surface-50));
  }

  .shell-tab-notch-pane-actions button:disabled {
    opacity: 0.28;
  }

  .shell-tab-notch-pane--drop {
    border-color: rgb(var(--color-primary-300) / 0.65);
    background: rgb(var(--color-primary-500) / 0.1);
  }

  .shell-tab-notch-pane--split-left {
    border-color: rgb(var(--color-primary-300) / 0.55);
    background: linear-gradient(
      to right,
      rgb(var(--color-primary-500) / 0.22) 0%,
      rgb(var(--color-primary-500) / 0.22) 32%,
      rgb(var(--color-surface-950) / 0.45) 32%
    );
    box-shadow: inset 2px 0 0 0 rgb(var(--color-primary-400) / 0.75);
  }

  .shell-tab-notch-pane--split-right {
    border-color: rgb(var(--color-primary-300) / 0.55);
    background: linear-gradient(
      to left,
      rgb(var(--color-primary-500) / 0.22) 0%,
      rgb(var(--color-primary-500) / 0.22) 32%,
      rgb(var(--color-surface-950) / 0.45) 32%
    );
    box-shadow: inset -2px 0 0 0 rgb(var(--color-primary-400) / 0.75);
  }

  .shell-tab-notch-pane--split-top {
    border-color: rgb(var(--color-primary-300) / 0.55);
    background: linear-gradient(
      to bottom,
      rgb(var(--color-primary-500) / 0.22) 0%,
      rgb(var(--color-primary-500) / 0.22) 32%,
      rgb(var(--color-surface-950) / 0.45) 32%
    );
    box-shadow: inset 0 2px 0 0 rgb(var(--color-primary-400) / 0.75);
  }

  .shell-tab-notch-pane--split-bottom {
    border-color: rgb(var(--color-primary-300) / 0.55);
    background: linear-gradient(
      to top,
      rgb(var(--color-primary-500) / 0.22) 0%,
      rgb(var(--color-primary-500) / 0.22) 32%,
      rgb(var(--color-surface-950) / 0.45) 32%
    );
    box-shadow: inset 0 -2px 0 0 rgb(var(--color-primary-400) / 0.75);
  }

  .shell-tab-notch-pane--vacant {
    border-style: dashed;
    border-color: rgb(var(--color-surface-500) / 0.3);
  }

  /* Arc/Zen vertical tab rail filling each map pane. */
  .shell-tab-notch-rail {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.14rem;
    margin: 0;
    list-style: none;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0.38rem;
    scrollbar-width: thin;
  }

  .shell-tab-notch-rail-item {
    min-width: 0;
  }

  .shell-tab-notch-rail-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.15rem;
    border-radius: 0.35rem;
    cursor: grab;
    transition: background-color 120ms ease;
  }

  .shell-tab-notch-rail-row:hover {
    background: rgb(var(--color-surface-800) / 0.55);
  }

  .shell-tab-notch-rail-row:hover .shell-tab-notch-rail-close {
    opacity: 1;
  }

  .shell-tab-notch-rail-row--active {
    background: rgb(var(--color-surface-700) / 0.72);
  }

  .shell-tab-notch-rail-row--active:hover {
    background: rgb(var(--color-surface-700) / 0.85);
  }

  .shell-tab-notch-rail-main {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: transparent;
    padding: 0.35rem 0.3rem 0.35rem 0.4rem;
    color: inherit;
    text-align: left;
    cursor: inherit;
  }

  .shell-tab-notch-rail-icon {
    flex-shrink: 0;
    color: rgb(var(--color-surface-300));
    opacity: 0.95;
  }

  .shell-tab-notch-rail-row--active .shell-tab-notch-rail-icon {
    color: rgb(var(--color-surface-200));
    opacity: 1;
  }

  .shell-tab-notch-rail-title {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    color: rgb(var(--color-surface-150, var(--color-surface-100)));
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shell-tab-notch-rail-row--active .shell-tab-notch-rail-title {
    color: rgb(var(--color-surface-50));
  }

  .shell-tab-notch-rail-close {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    margin-right: 0.2rem;
    color: rgb(var(--theme-text-tertiary));
    opacity: 0;
    transition:
      opacity 120ms ease,
      background-color 120ms ease,
      color 120ms ease;
  }

  .shell-tab-notch-rail-close:hover {
    background: rgb(var(--color-surface-600) / 0.55);
    color: rgb(var(--color-surface-100));
  }

  .shell-tab-notch-rail-vacant {
    display: flex;
    min-height: 5rem;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    color: rgb(var(--theme-text-quiet));
    font-size: 0.7rem;
    font-weight: 450;
    text-align: center;
  }
}
