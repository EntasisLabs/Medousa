@layer base, components, utilities, features;

@import "./lib/styles/chat-mobile-tokens.postcss";
@import "./lib/styles/syntax-tokens.postcss";
@import "./lib/styles/markdown-tokens.postcss";
@import "./lib/styles/callout-tokens.postcss";
@import "./lib/styles/block-tokens.postcss";
@import "./lib/styles/chart-tokens.postcss";
@import "./lib/styles/workshop-shell.postcss";
@import "./lib/styles/theme-semantic.postcss";

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html,
  body {
    height: 100%;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  html {
    --mobile-keyboard-inset: 0px;
    --mobile-bottom-chrome-height: 5.5rem;
    /* Lucide stroke weight — slightly heavier than the old 1.5–1.75 chrome default. */
    --icon-stroke: 2.15;
    /* Legacy font multipliers stay at 1; real UI zoom is Tauri webview setZoom
       (see contentZoom.ts). Never put CSS zoom on individual scroll hosts. */
    --content-zoom: 1;
    /* Chrome typography scale — dense UI chrome (toolbars, status, menus).
       Floor is 11px; pairs with Tailwind `text-chrome-*` utilities. */
    --chrome-xs: 11px;
    --chrome-sm: 12px;
    --chrome-md: 13px;
  }

  /* App-wide Lucide weight. Overrides per-icon stroke-width attrs (charts stay untouched). */
  svg.lucide {
    stroke-width: var(--icon-stroke);
  }

  /* iOS WKWebView auto-zooms focused inputs below 16px — enforce minimum app-wide. */
  html[data-native-shell="ios"] :is(
      input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="hidden"]):not(
          [type="file"]
        ),
      textarea,
      select
    ) {
    font-size: 16px;
  }

  @media (max-width: 640px) {
    html :is(
        input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not(
            [type="hidden"]
          ):not([type="file"]),
        textarea,
        select
      ) {
      font-size: 16px;
    }
  }

  html.dark body {
    @apply antialiased text-surface-50;
    background-color: rgb(var(--color-surface-950));
  }

  /* Edge-to-edge iOS: match WKWebView / status-bar backdrop to the shell canvas. */
  html[data-native-shell="ios"],
  html[data-native-shell="ios"] body {
    background-color: rgb(var(--color-surface-950));
  }

  html:not(.dark) body {
    -webkit-font-smoothing: antialiased;
    color: rgb(var(--color-surface-50));
    background-color: rgb(var(--color-surface-950));
  }

  /* Global reduced-motion policy — feature sheets may add their own overrides. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

@layer components {


  /* Skeleton card variant (legacy — prefer workshop-kanban-card) */
  .card {
    @apply border-surface-500/40 bg-surface-800/80;
  }

  .input,
  .textarea,
  .select {
    @apply border-surface-500/50 bg-surface-800 text-surface-50 placeholder:text-content-tertiary;
  }

  .checkbox {
    @apply border-surface-500/55;
  }

  html[data-mobile-browser-url-active="true"] [data-browser-bottom-chrome] {
    transform: translateY(calc(-1 * var(--mobile-keyboard-inset, 0px)));
  }

  [data-browser-embed-host] {
    contain: layout style;
  }

  /* Desktop native embed: transparent hole in shell webview so child WKWebView shows through. */
  [data-browser-embed-host].pointer-events-none {
    background: transparent !important;
  }

  /* Black Lily / Obsidian theme overlays live in theme-*.postcss */

  /* Light mode shell regions live in workshop-shell.postcss (--shell-* tokens). */

  /* Temporary layout debug — enabled via data-layout-debug on Tauri iOS */
  html[data-layout-debug] body {
    outline: 3px solid #f97316;
    outline-offset: -3px;
  }

  html[data-layout-debug]::after {
    content: "";
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: #ec4899;
    z-index: 99998;
    pointer-events: none;
  }

  /* Above notch chrome (notch 146 / drawer 145) when opened from the tab map. */
  .shell-context-menu {
    z-index: 160;
  }
}
