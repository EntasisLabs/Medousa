{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medousa",
  "version": "0.10.3",
  "identifier": "com.entasislabs.medousa-home",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:sidecar",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Medousa",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; media-src 'self' data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; frame-src 'self' http: https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/medousa_daemon"],
    "resources": [
      "resources/docs/runbooks/connection-reliability.md"
    ],
    "iOS": {
      "minimumSystemVersion": "16.2",
      "developmentTeam": "K5SZ28RN9P",
      "infoPlist": "Info.mobile.plist"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["medousa"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["medousa"]
      }
    }
  }
}
