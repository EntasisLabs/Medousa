	<string>Medousa records audio when you tap the voice button so your message can be transcribed in chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Medousa lets you choose photos from your library to attach to your chat.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
